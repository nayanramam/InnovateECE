[03/13 13:33:58     40s]         set_distributed_hosts -local
[03/13 13:33:58     40s]       }
[03/13 13:33:58     40s] }
[03/13 13:33:58     40s]   }}
[03/13 13:33:58     40s] set_multi_cpu_usage -local_cpu 1
