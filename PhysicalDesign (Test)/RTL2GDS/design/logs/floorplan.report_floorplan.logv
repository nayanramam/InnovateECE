[03/13 13:33:58     40s]     #-----------------------------------------------------------------------------
[03/13 13:33:58     40s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/13 13:33:58     40s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/13 13:33:58     40s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/13 13:33:58     40s]     # a typical environment variable exported by distribution platforms and is
[03/13 13:33:58     40s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/13 13:33:58     40s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/13 13:33:58     40s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/13 13:33:58     40s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/13 13:33:58     40s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/13 13:33:58     40s]     } else {
[03/13 13:33:58     40s]       set max_cpus 1
[03/13 13:33:58     40s]     }
[03/13 13:33:58     40s]     switch -glob [get_db program_short_name] {
[03/13 13:33:58     40s]       default       {}
[03/13 13:33:58     40s]       joules*       -
[03/13 13:33:58     40s]       genus*        -
[03/13 13:33:58     40s]       innovus*      -
[03/13 13:33:58     40s]       tempus*       -
[03/13 13:33:58     40s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/13 13:33:58     40s]     }
[03/13 13:33:58     40s] if {[get_feature opt_signoff]} {
[03/13 13:33:58     40s]       if {[is_flow -inside flow:opt_signoff]} {
[03/13 13:33:58     40s]         set_multi_cpu_usage -verbose -remote_host 1
