[03/13 13:44:03     43s]           }
[03/13 13:44:03     43s]         }
[03/13 13:44:03     43s]         if {$dynamic_view ne ""} {
[03/13 13:44:03     43s]           append cmd " -dynamic [list $dynamic_view]"
[03/13 13:44:03     43s]         } else {
