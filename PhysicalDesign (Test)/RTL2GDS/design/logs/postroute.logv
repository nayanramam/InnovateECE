[03/13 13:46:00    115s] #@ Begin verbose flow_step implementation.postroute.block_finish
[03/13 13:46:00    115s] @flow 2: apply {{} {
[03/13 13:46:00    115s]     #- Make sure flow_report_name is reset from any reports executed during the flow
[03/13 13:46:00    115s]     set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
[03/13 13:46:00    115s]     #- Set DB for handoff to Innovus
[03/13 13:46:00    115s]     if {[is_flow -inside flow:syn_opt]} {
[03/13 13:46:00    115s]       set_db flow_write_db_common true
[03/13 13:46:00    115s]     }
[03/13 13:46:00    115s]   
[03/13 13:46:00    115s]     #- Set value for SPEF output file generation
[03/13 13:46:00    115s]     if {[get_db flow_branch] ne ""} {
[03/13 13:46:00    115s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/13 13:46:00    115s]     } else {
[03/13 13:46:00    115s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
[03/13 13:46:00    115s]     }
[03/13 13:46:00    115s]     set_db flow_spef_directory $out_dir
[03/13 13:46:00    115s]   
[03/13 13:46:00    115s]     #- Store non-default root attributes to metrics
[03/13 13:46:00    115s]     catch {report_obj -tcl} flow_root_config
[03/13 13:46:00    115s]     if {[dict exists $flow_root_config root:/]} {
[03/13 13:46:00    115s]       set flow_root_config [dict get $flow_root_config root:/]
[03/13 13:46:00    115s]     } elseif {[dict exists $flow_root_config root:]} {
[03/13 13:46:00    115s]       set flow_root_config [dict get $flow_root_config root:]
[03/13 13:46:00    115s]     } else {
[03/13 13:46:00    115s]     }
[03/13 13:46:00    115s]     foreach key [dict keys $flow_root_config] {
[03/13 13:46:00    115s]       if {[string length [dict get $flow_root_config $key]] > 200} {
[03/13 13:46:00    115s]         dict set flow_root_config $key "\[long value truncated\]"
[03/13 13:46:00    115s]       }
[03/13 13:46:00    115s]     }
[03/13 13:46:00    115s]     set_metric -name flow.root_config -value $flow_root_config
[03/13 13:46:00    115s]   }}
[03/13 13:46:01    116s] #@ End verbose flow_step implementation.postroute.block_finish
