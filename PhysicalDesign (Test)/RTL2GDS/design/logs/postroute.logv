[03/13 13:44:03     43s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/13 13:44:03     43s]   
[03/13 13:44:03     43s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
