[03/13 13:44:03     43s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/13 13:44:03     43s]         set cmd "set_analysis_view"
[03/13 13:44:03     43s]         if {$setup_views ne ""} {
[03/13 13:44:03     43s]           append cmd " -setup [list $setup_views]"
[03/13 13:44:03     43s]         } else {
