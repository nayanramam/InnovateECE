[03/13 13:33:57     40s]         set_distributed_hosts -local
[03/13 13:33:57     40s]       }
[03/13 13:33:57     40s] }
[03/13 13:33:57     40s]   }}
[03/13 13:33:57     40s] set_multi_cpu_usage -local_cpu 1
