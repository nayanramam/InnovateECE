[03/13 13:36:41     41s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/13 13:36:41     41s]   
[03/13 13:36:41     41s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
