postcts:        }
postcts:        if {$dynamic_view ne ""} {
postcts:          append cmd " -dynamic_view [list $dynamic_view]"
postcts:        }
postcts:        eval $cmd
postcts:      } else {
postcts:      }
postcts:    }
postcts:  }}
