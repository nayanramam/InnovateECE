floorplan:@file 32: # Dedicated met4 vertical stripe pair at SRAM right boundary (~X=713)
floorplan:@file 33: # The global met4 stripes land at X=685 (blocked by SRAM) and X=735 (22um away).
floorplan:@file 34: # This pair sits just outside the SRAM right edge so route_special can build
