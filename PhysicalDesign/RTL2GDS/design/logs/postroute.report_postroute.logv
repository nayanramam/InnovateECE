[03/16 13:04:07     33s] @flow 2: apply {{} {
[03/16 13:04:07     33s]     # Multi host/cpu attributes
[03/16 13:04:07     33s]     #-----------------------------------------------------------------------------
[03/16 13:04:07     33s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/16 13:04:07     33s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/16 13:04:07     33s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/16 13:04:07     33s]     # a typical environment variable exported by distribution platforms and is
[03/16 13:04:07     33s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/16 13:04:07     33s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/16 13:04:07     33s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/16 13:04:07     33s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/16 13:04:07     33s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/16 13:04:07     33s]     } else {
[03/16 13:04:07     33s]       set max_cpus 1
[03/16 13:04:07     33s]     }
[03/16 13:04:07     33s]     switch -glob [get_db program_short_name] {
[03/16 13:04:07     33s]       default       {}
[03/16 13:04:07     33s]       joules*       -
[03/16 13:04:07     33s]       genus*        -
