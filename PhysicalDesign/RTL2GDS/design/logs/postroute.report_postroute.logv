[03/17 20:27:29     48s]     set leakage_view [get_feature -obj $flow leakage_view]
[03/17 20:27:29     48s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/17 20:27:29     48s]   
[03/17 20:27:29     48s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
