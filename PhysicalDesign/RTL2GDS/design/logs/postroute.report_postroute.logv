[03/17 20:27:29     48s]           }
[03/17 20:27:29     48s]         }
[03/17 20:27:29     48s]         if {$dynamic_view ne ""} {
[03/17 20:27:29     48s]           append cmd " -dynamic [list $dynamic_view]"
[03/17 20:27:29     48s]         } else {
