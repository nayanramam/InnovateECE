[03/16 13:04:18     42s]           }
[03/16 13:04:18     42s]         }
[03/16 13:04:18     42s]         if {$dynamic_view ne ""} {
[03/16 13:04:18     42s]           append cmd " -dynamic [list $dynamic_view]"
