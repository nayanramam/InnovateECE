[03/17 20:27:16     36s] @flow 2: apply {{} {
[03/17 20:27:16     36s]     # Multi host/cpu attributes
[03/17 20:27:16     36s]     #-----------------------------------------------------------------------------
[03/17 20:27:16     36s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 20:27:16     36s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 20:27:16     36s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 20:27:16     36s]     # a typical environment variable exported by distribution platforms and is
[03/17 20:27:16     36s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 20:27:16     36s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 20:27:16     36s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 20:27:16     36s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 20:27:16     36s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 20:27:16     36s]     } else {
[03/17 20:27:16     36s]       set max_cpus 1
[03/17 20:27:16     36s]     }
[03/17 20:27:16     36s]     switch -glob [get_db program_short_name] {
[03/17 20:27:16     36s]       default       {}
[03/17 20:27:16     36s]       joules*       -
[03/17 20:27:16     36s]       genus*        -
