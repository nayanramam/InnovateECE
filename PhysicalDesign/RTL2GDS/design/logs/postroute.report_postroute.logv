[03/17 20:27:16     36s]         set_distributed_hosts -local
[03/17 20:27:16     36s]       }
[03/17 20:27:16     36s] }
[03/17 20:27:16     36s]   }}
[03/17 20:27:16     36s] set_multi_cpu_usage -local_cpu 1
