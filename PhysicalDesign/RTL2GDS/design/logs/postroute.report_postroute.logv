[03/16 13:04:18     42s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/16 13:04:18     42s]   
[03/16 13:04:18     42s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
