[03/16 12:28:34     33s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/16 12:28:34     33s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/16 12:28:34     33s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
