[03/23 21:46:32     40s] @flow 2: apply {{} {
[03/23 21:46:32     40s]     # Multi host/cpu attributes
[03/23 21:46:32     40s]     #-----------------------------------------------------------------------------
[03/23 21:46:32     40s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/23 21:46:32     40s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/23 21:46:32     40s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/23 21:46:32     40s]     # a typical environment variable exported by distribution platforms and is
[03/23 21:46:32     40s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/23 21:46:32     40s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/23 21:46:32     40s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/23 21:46:32     40s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/23 21:46:32     40s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/23 21:46:32     40s]     } else {
