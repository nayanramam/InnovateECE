[03/17 22:45:45     46s]         set_distributed_hosts -local
[03/17 22:45:45     46s]       }
[03/17 22:45:45     46s] }
[03/17 22:45:45     46s]   }}
[03/17 22:45:45     46s] set_multi_cpu_usage -local_cpu 1
