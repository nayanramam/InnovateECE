[03/17 22:45:45     46s]     #-----------------------------------------------------------------------------
[03/17 22:45:45     46s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 22:45:45     46s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 22:45:45     46s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 22:45:45     46s]     # a typical environment variable exported by distribution platforms and is
[03/17 22:45:45     46s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 22:45:45     46s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 22:45:45     46s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 22:45:45     46s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 22:45:45     46s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 22:45:45     46s]     } else {
[03/17 22:45:45     46s]       set max_cpus 1
[03/17 22:45:45     46s]     }
[03/17 22:45:45     46s]     switch -glob [get_db program_short_name] {
[03/17 22:45:45     46s]       default       {}
[03/17 22:45:45     46s]       joules*       -
[03/17 22:45:45     46s]       genus*        -
[03/17 22:45:45     46s]       innovus*      -
[03/17 22:45:45     46s]       tempus*       -
[03/17 22:45:45     46s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/17 22:45:45     46s]     }
[03/17 22:45:45     46s] if {[get_feature opt_signoff]} {
[03/17 22:45:45     46s]       if {[is_flow -inside flow:opt_signoff]} {
[03/17 22:45:45     46s]         set_multi_cpu_usage -verbose -remote_host 1
