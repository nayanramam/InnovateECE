[03/23 22:43:00    267s]     }
[03/23 22:43:00    267s]   
[03/23 22:43:00    267s]     #- Set value for SPEF output file generation
[03/23 22:43:00    267s]     if {[get_db flow_branch] ne ""} {
[03/23 22:43:00    267s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/23 22:43:00    267s]     } else {
