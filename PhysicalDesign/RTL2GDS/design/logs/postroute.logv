[03/23 22:43:58    322s] #@ Begin verbose flow_step implementation.postroute.innovus_to_tempus
[03/23 22:43:58    322s] @flow 2: apply {{} {
[03/23 22:43:58    322s]     #- initialize sta analysis_views
[03/23 22:43:58    322s]     if {([get_feature -obj flow:sta setup_views] ne "") || ([get_feature -obj flow:sta hold_views] ne "")} {
[03/23 22:43:58    322s]       set cmd "set_analysis_view"
[03/23 22:43:58    322s]       if {[get_feature -obj flow:sta setup_views] ne ""} {
[03/23 22:43:58    322s]         set cmd "$cmd -setup [list [get_db analysis_views [get_feature -obj flow:sta setup_views]]]"
[03/23 22:43:58    322s]       } else {
[03/23 22:43:58    322s]         set cmd "$cmd -setup [list [get_db analysis_views -if .is_setup]]"
[03/23 22:43:58    322s]       }
[03/23 22:43:58    322s]       if {[get_feature -obj flow:sta hold_views] ne ""} {
[03/23 22:43:58    322s]         set cmd "$cmd -hold [list [get_db analysis_views [get_feature -obj flow:sta hold_views]]]"
[03/23 22:43:58    322s]       } else {
[03/23 22:43:58    322s]         set cmd "$cmd -hold [list [get_db analysis_views -if .is_hold]]"
[03/23 22:43:58    322s]       }
[03/23 22:43:58    322s]       eval "$cmd -leakage [get_db analysis_views -if .is_leakage] -dynamic [get_db analysis_views -if .is_dynamic]"
[03/23 22:43:58    322s]     }
[03/23 22:43:58    322s]     #- write design and library information
[03/23 22:43:58    322s]     if {[get_db flow_branch] ne ""} {
[03/23 22:43:58    322s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/23 22:43:58    322s]     } else {
[03/23 22:43:58    322s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
[03/23 22:43:58    322s]     }
[03/23 22:43:58    322s]     if {[llength [get_db -u rc_corners .cap_table_file]] > 0} {
[03/23 22:43:58    322s]       write_design -tempus -signoff_eco $out_dir
[03/23 22:43:58    322s]     } else {
[03/23 22:43:58    322s]       write_design -tempus $out_dir
[03/23 22:43:58    322s]     }
[03/23 22:43:58    322s]   
[03/23 22:43:58    322s]     #- write init_design sequence for STA flow
[03/23 22:43:58    322s]     set FH [open [file join $out_dir init_sta.tcl] w]
[03/23 22:43:58    322s]     puts $FH {#dataVar is dir where this script is found}
[03/23 22:43:58    322s]     puts $FH {set dataVar [file dirname [file normalize [info script]]]}
[03/23 22:43:58    322s]     if {![string is space [get_flow_config -quiet init_physical_files oa_ref_libs]]} {
[03/23 22:43:58    322s]       puts $FH "cd [get_db flow_startup_directory]"
[03/23 22:43:58    322s]     }
[03/23 22:43:58    322s]     puts $FH "source -quiet [file join  \$dataVar [get_db current_design .name].tempus_setup.tcl]"
[03/23 22:43:58    322s]     if {![string is space [get_flow_config -quiet init_physical_files oa_ref_libs]]} {
[03/23 22:43:58    322s]       puts $FH "cd \[get_db flow_working_directory\]"
[03/23 22:43:58    322s]     }
[03/23 22:43:58    322s]     puts $FH "set_db flow_report_name [get_db flow_report_name]"
[03/23 22:43:58    322s]     puts $FH "set_db flow_spef_directory [get_db flow_spef_directory]"
[03/23 22:43:58    322s]     close $FH
[03/23 22:43:58    322s]   }}
