[03/16 13:02:04    613s] #@ Begin verbose flow_step implementation.postroute.block_finish
[03/16 13:02:04    613s] @flow 2: apply {{} {
[03/16 13:02:04    613s]     #- Make sure flow_report_name is reset from any reports executed during the flow
[03/16 13:02:04    613s]     set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
[03/16 13:02:04    613s]     #- Set DB for handoff to Innovus
[03/16 13:02:04    613s]     if {[is_flow -inside flow:syn_opt]} {
[03/16 13:02:04    613s]       set_db flow_write_db_common true
[03/16 13:02:04    613s]     }
[03/16 13:02:04    613s]   
[03/16 13:02:04    613s]     #- Set value for SPEF output file generation
[03/16 13:02:04    613s]     if {[get_db flow_branch] ne ""} {
[03/16 13:02:04    613s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/16 13:02:04    613s]     } else {
[03/16 13:02:04    613s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
[03/16 13:02:04    613s]     }
[03/16 13:02:04    613s]     set_db flow_spef_directory $out_dir
[03/16 13:02:04    613s]   
[03/16 13:02:04    613s]     #- Store non-default root attributes to metrics
[03/16 13:02:04    613s]     catch {report_obj -tcl} flow_root_config
[03/16 13:02:04    613s]     if {[dict exists $flow_root_config root:/]} {
[03/16 13:02:04    613s]       set flow_root_config [dict get $flow_root_config root:/]
[03/16 13:02:04    613s]     } elseif {[dict exists $flow_root_config root:]} {
[03/16 13:02:04    613s]       set flow_root_config [dict get $flow_root_config root:]
[03/16 13:02:04    613s]     } else {
[03/16 13:02:04    613s]     }
[03/16 13:02:04    613s]     foreach key [dict keys $flow_root_config] {
[03/16 13:02:04    613s]       if {[string length [dict get $flow_root_config $key]] > 200} {
[03/16 13:02:04    613s]         dict set flow_root_config $key "\[long value truncated\]"
[03/16 13:02:04    613s]       }
[03/16 13:02:04    613s]     }
[03/16 13:02:04    613s]     set_metric -name flow.root_config -value $flow_root_config
[03/16 13:02:04    613s]   }}
[03/16 13:02:04    613s] #@ End verbose flow_step implementation.postroute.block_finish
