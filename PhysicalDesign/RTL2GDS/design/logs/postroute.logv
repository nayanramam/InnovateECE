[03/23 22:43:00    267s]   
[03/23 22:43:00    267s]     #- Store non-default root attributes to metrics
[03/23 22:43:00    267s]     catch {report_obj -tcl} flow_root_config
[03/23 22:43:00    267s]     if {[dict exists $flow_root_config root:/]} {
