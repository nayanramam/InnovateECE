[03/23 22:42:41    250s]     delete_markers
[03/23 22:42:41    250s]     check_drc -limit 100000
[03/23 22:42:41    250s]     set drcMList [get_db markers]
[03/23 22:42:41    250s]     set drc_iter 0
[03/23 22:42:41    250s]     set max_drc_iter 4
[03/23 22:42:41    250s]     while { ([llength $drcMList] > 0) && ($drc_iter < $max_drc_iter) } {
[03/23 22:42:41    250s]       puts "Found [llength $drcMList] DRC markers. Starting route_eco to fix DRCs (iteration $drc_iter)"
[03/23 22:42:41    250s]       route_eco -fix_drc
[03/23 22:42:41    250s]       delete_markers
[03/23 22:42:41    250s]       check_drc -limit 100000
[03/23 22:42:41    250s]       set drcMList [get_db markers]
[03/23 22:42:41    250s]       incr drc_iter
[03/23 22:42:41    250s]     }
[03/23 22:42:41    250s]     puts "DRC fixing completed after $drc_iter iterations. Remaining DRCs are [llength $drcMList]."
[03/23 22:42:41    250s]     if { ([llength $drcMList] > 0) } {
[03/23 22:42:41    250s]       delete_routes -regular_wire_with_drc
[03/23 22:42:41    250s]       route_global_detail
[03/23 22:42:41    250s]       check_drc -limit 100000
[03/23 22:42:41    250s]       set drcMList [get_db markers]
[03/23 22:42:41    250s]       puts "Last round of DRC fixing completed after $drc_iter iterations. Remaining DRCs are [llength $drcMList]."
[03/23 22:42:41    250s]     }
[03/23 22:42:41    250s]   }}
