[03/17 23:17:12    330s]   
[03/17 23:17:12    330s]     #- Store non-default root attributes to metrics
[03/17 23:17:12    330s]     catch {report_obj -tcl} flow_root_config
[03/17 23:17:12    330s]     if {[dict exists $flow_root_config root:/]} {
[03/17 23:17:12    330s]       set flow_root_config [dict get $flow_root_config root:/]
[03/17 23:17:12    330s]     } elseif {[dict exists $flow_root_config root:]} {
