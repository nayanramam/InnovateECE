[03/17 23:17:12    330s]     } else {
[03/17 23:17:12    330s]     }
[03/17 23:17:12    330s]     foreach key [dict keys $flow_root_config] {
[03/17 23:17:12    330s]       if {[string length [dict get $flow_root_config $key]] > 200} {
[03/17 23:17:12    330s]         dict set flow_root_config $key "\[long value truncated\]"
[03/17 23:17:12    330s]       }
[03/17 23:17:12    330s]     }
[03/17 23:17:12    330s]     set_metric -name flow.root_config -value $flow_root_config
[03/17 23:17:12    330s]   }}
