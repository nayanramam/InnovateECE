[03/17 23:17:12    330s]     if {[is_flow -inside flow:syn_opt]} {
[03/17 23:17:12    330s]       set_db flow_write_db_common true
[03/17 23:17:12    330s]     }
[03/17 23:17:12    330s]   
[03/17 23:17:12    330s]     #- Set value for SPEF output file generation
[03/17 23:17:12    330s]     if {[get_db flow_branch] ne ""} {
[03/17 23:17:12    330s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/17 23:17:12    330s]     } else {
[03/17 23:17:12    330s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
[03/17 23:17:12    330s]     }
