[03/17 23:16:50    308s] @flow 2: apply {{} {
[03/17 23:16:50    308s]     delete_markers
[03/17 23:16:50    308s]     check_drc -limit 100000
[03/17 23:16:50    308s]     set drcMList [get_db markers]
[03/17 23:16:50    308s]     set drc_iter 0
[03/17 23:16:50    308s]     set max_drc_iter 4
[03/17 23:16:50    308s]     while { ([llength $drcMList] > 0) && ($drc_iter < $max_drc_iter) } {
[03/17 23:16:50    308s]       puts "Found [llength $drcMList] DRC markers. Starting route_eco to fix DRCs (iteration $drc_iter)"
[03/17 23:16:50    308s]       route_eco -fix_drc
[03/17 23:16:50    308s]       delete_markers
[03/17 23:16:50    308s]       check_drc -limit 100000
[03/17 23:16:50    308s]       set drcMList [get_db markers]
[03/17 23:16:50    308s]       incr drc_iter
[03/17 23:16:50    308s]     }
[03/17 23:16:50    308s]     puts "DRC fixing completed after $drc_iter iterations. Remaining DRCs are [llength $drcMList]."
[03/17 23:16:50    308s]     if { ([llength $drcMList] > 0) } {
[03/17 23:16:50    308s]       delete_routes -regular_wire_with_drc
[03/17 23:16:50    308s]       route_global_detail
[03/17 23:16:50    308s]       check_drc -limit 100000
[03/17 23:16:50    308s]       set drcMList [get_db markers]
