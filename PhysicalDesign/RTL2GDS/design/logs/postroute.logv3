[03/18 00:15:13     36s]     # a typical environment variable exported by distribution platforms and is
[03/18 00:15:13     36s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/18 00:15:13     36s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/18 00:15:13     36s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/18 00:15:13     36s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
