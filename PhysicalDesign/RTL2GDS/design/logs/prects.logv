[03/23 21:53:06     41s]     }
[03/23 21:53:06     41s]     switch -glob [get_db program_short_name] {
[03/23 21:53:06     41s]       default       {}
[03/23 21:53:06     41s]       joules*       -
[03/23 21:53:06     41s]       genus*        -
[03/23 21:53:06     41s]       innovus*      -
