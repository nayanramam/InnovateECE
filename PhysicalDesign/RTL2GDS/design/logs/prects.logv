[03/16 12:28:42     39s] #@ Begin verbose flow_step init_mcpu
[03/16 12:28:42     39s] @flow 2: apply {{} {
[03/16 12:28:42     39s]     # Multi host/cpu attributes
[03/16 12:28:42     39s]     #-----------------------------------------------------------------------------
[03/16 12:28:42     39s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/16 12:28:42     39s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/16 12:28:42     39s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/16 12:28:42     39s]     # a typical environment variable exported by distribution platforms and is
[03/16 12:28:42     39s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/16 12:28:42     39s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/16 12:28:42     39s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/16 12:28:42     39s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/16 12:28:42     39s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/16 12:28:42     39s]     } else {
[03/16 12:28:42     39s]       set max_cpus 1
[03/16 12:28:42     39s]     }
[03/16 12:28:42     39s]     switch -glob [get_db program_short_name] {
[03/16 12:28:42     39s]       default       {}
[03/16 12:28:42     39s]       joules*       -
[03/16 12:28:42     39s]       genus*        -
[03/16 12:28:42     39s]       innovus*      -
[03/16 12:28:42     39s]       tempus*       -
[03/16 12:28:42     39s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/16 12:28:42     39s]     }
[03/16 12:28:42     39s] if {[get_feature opt_signoff]} {
[03/16 12:28:42     39s]       if {[is_flow -inside flow:opt_signoff]} {
[03/16 12:28:42     39s]         set_multi_cpu_usage -verbose -remote_host 1
[03/16 12:28:42     39s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/16 12:28:42     39s]         set_distributed_hosts -local
[03/16 12:28:42     39s]       }
[03/16 12:28:42     39s] }
[03/16 12:28:42     39s]   }}
[03/16 12:28:42     39s] set_multi_cpu_usage -local_cpu 1
[03/16 12:28:42     39s] #@ End verbose flow_step init_mcpu
