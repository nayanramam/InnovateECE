[03/23 21:53:06     41s]     #-----------------------------------------------------------------------------
[03/23 21:53:06     41s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/23 21:53:06     41s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/23 21:53:06     41s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/23 21:53:06     41s]     # a typical environment variable exported by distribution platforms and is
[03/23 21:53:06     41s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/23 21:53:06     41s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/23 21:53:06     41s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/23 21:53:06     41s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/23 21:53:06     41s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/23 21:53:06     41s]     } else {
