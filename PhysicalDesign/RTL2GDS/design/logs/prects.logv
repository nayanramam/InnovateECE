[03/16 12:28:33     32s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/16 12:28:33     32s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/16 12:28:33     32s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
