[03/17 22:53:51     37s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 22:53:51     37s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 22:53:51     37s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
