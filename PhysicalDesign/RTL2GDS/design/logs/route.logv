[03/23 22:32:52     44s] #@ Begin verbose flow_step init_mcpu
[03/23 22:32:52     44s] @flow 2: apply {{} {
[03/23 22:32:52     44s]     # Multi host/cpu attributes
[03/23 22:32:52     44s]     #-----------------------------------------------------------------------------
[03/23 22:32:52     44s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/23 22:32:52     44s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/23 22:32:52     44s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/23 22:32:52     44s]     # a typical environment variable exported by distribution platforms and is
[03/23 22:32:52     44s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/23 22:32:52     44s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/23 22:32:52     44s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/23 22:32:52     44s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/23 22:32:52     44s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/23 22:32:52     44s]     } else {
[03/23 22:32:52     44s]       set max_cpus 1
[03/23 22:32:52     44s]     }
[03/23 22:32:52     44s]     switch -glob [get_db program_short_name] {
[03/23 22:32:52     44s]       default       {}
[03/23 22:32:52     44s]       joules*       -
[03/23 22:32:52     44s]       genus*        -
[03/23 22:32:52     44s]       innovus*      -
[03/23 22:32:52     44s]       tempus*       -
[03/23 22:32:52     44s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/23 22:32:52     44s]     }
[03/23 22:32:52     44s] if {[get_feature opt_signoff]} {
[03/23 22:32:52     44s]       if {[is_flow -inside flow:opt_signoff]} {
[03/23 22:32:52     44s]         set_multi_cpu_usage -verbose -remote_host 1
[03/23 22:32:52     44s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/23 22:32:52     44s]         set_distributed_hosts -local
[03/23 22:32:52     44s]       }
[03/23 22:32:52     44s] }
[03/23 22:32:52     44s]   }}
[03/23 22:32:52     44s] set_multi_cpu_usage -local_cpu 1
[03/23 22:32:52     44s] #@ End verbose flow_step init_mcpu
