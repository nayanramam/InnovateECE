[03/17 23:45:01     49s]     set hold_views [get_feature -obj $flow hold_views]
[03/17 23:45:01     49s]     set leakage_view [get_feature -obj $flow leakage_view]
[03/17 23:45:01     49s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/17 23:45:01     49s]   
[03/17 23:45:01     49s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/17 23:45:01     49s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/17 23:45:01     49s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/17 23:45:01     49s]         set cmd "set_analysis_view"
[03/17 23:45:01     49s]         if {$setup_views ne ""} {
[03/17 23:45:01     49s]           append cmd " -setup [list $setup_views]"
[03/17 23:45:01     49s]         } else {
[03/17 23:45:01     49s]           append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
[03/17 23:45:01     49s]         }
[03/17 23:45:01     49s]         if {$hold_views ne ""} {
[03/17 23:45:01     49s]           append cmd " -hold [list $hold_views]"
[03/17 23:45:01     49s]         } else {
[03/17 23:45:01     49s]           append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
[03/17 23:45:01     49s]         }
[03/17 23:45:01     49s]         if {$leakage_view ne ""} {
[03/17 23:45:01     49s]           append cmd " -leakage [list $leakage_view]"
[03/17 23:45:01     49s]         } else {
