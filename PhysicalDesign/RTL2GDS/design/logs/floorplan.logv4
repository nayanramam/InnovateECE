[03/17 23:45:01     49s]           }
[03/17 23:45:01     49s]         }
[03/17 23:45:01     49s]         if {$dynamic_view ne ""} {
[03/17 23:45:01     49s]           append cmd " -dynamic [list $dynamic_view]"
