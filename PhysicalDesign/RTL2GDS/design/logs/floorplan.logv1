[03/17 20:54:26     36s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 20:54:26     36s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 20:54:26     36s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
