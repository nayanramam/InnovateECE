[03/17 21:17:15     47s]     set hold_views [get_feature -obj $flow hold_views]
[03/17 21:17:15     47s]     set leakage_view [get_feature -obj $flow leakage_view]
[03/17 21:17:15     47s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/17 21:17:15     47s]   
[03/17 21:17:15     47s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/17 21:17:15     47s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/17 21:17:15     47s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/17 21:17:15     47s]         set cmd "set_analysis_view"
[03/17 21:17:15     47s]         if {$setup_views ne ""} {
[03/17 21:17:15     47s]           append cmd " -setup [list $setup_views]"
[03/17 21:17:15     47s]         } else {
[03/17 21:17:15     47s]           append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
[03/17 21:17:15     47s]         }
[03/17 21:17:15     47s]         if {$hold_views ne ""} {
[03/17 21:17:15     47s]           append cmd " -hold [list $hold_views]"
[03/17 21:17:15     47s]         } else {
[03/17 21:17:15     47s]           append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
[03/17 21:17:15     47s]         }
[03/17 21:17:15     47s]         if {$leakage_view ne ""} {
[03/17 21:17:15     47s]           append cmd " -leakage [list $leakage_view]"
[03/17 21:17:15     47s]         } else {
[03/17 21:17:15     47s]           if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
[03/17 21:17:15     47s]             append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
[03/17 21:17:15     47s]           }
[03/17 21:17:15     47s]         }
[03/17 21:17:15     47s]         if {$dynamic_view ne ""} {
[03/17 21:17:15     47s]           append cmd " -dynamic [list $dynamic_view]"
[03/17 21:17:15     47s]         } else {
[03/17 21:17:15     47s]           if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
[03/17 21:17:15     47s]             append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
[03/17 21:17:15     47s]           }
[03/17 21:17:15     47s]         }
[03/17 21:17:15     47s]         eval $cmd
[03/17 21:17:15     47s]       } elseif {[llength [get_db analysis_views]] == 0} {
