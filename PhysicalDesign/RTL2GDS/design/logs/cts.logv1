[03/17 21:17:15     47s] #@ Begin verbose flow_step init_mcpu
[03/17 21:17:15     47s] @flow 2: apply {{} {
[03/17 21:17:15     47s]     # Multi host/cpu attributes
[03/17 21:17:15     47s]     #-----------------------------------------------------------------------------
[03/17 21:17:15     47s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 21:17:15     47s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 21:17:15     47s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 21:17:15     47s]     # a typical environment variable exported by distribution platforms and is
[03/17 21:17:15     47s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 21:17:15     47s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 21:17:15     47s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 21:17:15     47s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 21:17:15     47s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 21:17:15     47s]     } else {
[03/17 21:17:15     47s]       set max_cpus 1
[03/17 21:17:15     47s]     }
[03/17 21:17:15     47s]     switch -glob [get_db program_short_name] {
[03/17 21:17:15     47s]       default       {}
[03/17 21:17:15     47s]       joules*       -
[03/17 21:17:15     47s]       genus*        -
[03/17 21:17:15     47s]       innovus*      -
[03/17 21:17:15     47s]       tempus*       -
[03/17 21:17:15     47s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/17 21:17:15     47s]     }
[03/17 21:17:15     47s] if {[get_feature opt_signoff]} {
[03/17 21:17:15     47s]       if {[is_flow -inside flow:opt_signoff]} {
[03/17 21:17:15     47s]         set_multi_cpu_usage -verbose -remote_host 1
[03/17 21:17:15     47s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/17 21:17:15     47s]         set_distributed_hosts -local
[03/17 21:17:15     47s]       }
[03/17 21:17:15     47s] }
[03/17 21:17:15     47s]   }}
[03/17 21:17:15     47s] set_multi_cpu_usage -local_cpu 1
[03/17 21:17:15     47s] #@ End verbose flow_step init_mcpu
[03/17 21:17:15     47s] End steps for plugin point Cadence.plugin.flowkit.read_db.post
