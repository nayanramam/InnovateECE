[03/17 23:58:48     50s] #@ Begin verbose flow_step init_mcpu
[03/17 23:58:48     50s] @flow 2: apply {{} {
[03/17 23:58:48     50s]     # Multi host/cpu attributes
[03/17 23:58:48     50s]     #-----------------------------------------------------------------------------
[03/17 23:58:48     50s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 23:58:48     50s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 23:58:48     50s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 23:58:48     50s]     # a typical environment variable exported by distribution platforms and is
[03/17 23:58:48     50s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 23:58:48     50s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 23:58:48     50s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 23:58:48     50s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 23:58:48     50s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 23:58:48     50s]     } else {
[03/17 23:58:48     50s]       set max_cpus 1
[03/17 23:58:48     50s]     }
[03/17 23:58:48     50s]     switch -glob [get_db program_short_name] {
[03/17 23:58:48     50s]       default       {}
[03/17 23:58:48     50s]       joules*       -
[03/17 23:58:48     50s]       genus*        -
[03/17 23:58:48     50s]       innovus*      -
[03/17 23:58:48     50s]       tempus*       -
[03/17 23:58:48     50s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/17 23:58:48     50s]     }
[03/17 23:58:48     50s] if {[get_feature opt_signoff]} {
[03/17 23:58:48     50s]       if {[is_flow -inside flow:opt_signoff]} {
[03/17 23:58:48     50s]         set_multi_cpu_usage -verbose -remote_host 1
[03/17 23:58:48     50s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/17 23:58:48     50s]         set_distributed_hosts -local
[03/17 23:58:48     50s]       }
[03/17 23:58:48     50s] }
[03/17 23:58:48     50s]   }}
[03/17 23:58:48     50s] set_multi_cpu_usage -local_cpu 1
[03/17 23:58:48     50s] #@ End verbose flow_step init_mcpu
