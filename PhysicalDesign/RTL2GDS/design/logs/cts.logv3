[03/17 23:58:34     38s] @flow 2: apply {{} {
[03/17 23:58:34     38s]     # Multi host/cpu attributes
[03/17 23:58:34     38s]     #-----------------------------------------------------------------------------
[03/17 23:58:34     38s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 23:58:34     38s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 23:58:34     38s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 23:58:34     38s]     # a typical environment variable exported by distribution platforms and is
[03/17 23:58:34     38s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 23:58:34     38s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 23:58:34     38s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 23:58:34     38s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 23:58:34     38s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 23:58:34     38s]     } else {
[03/17 23:58:34     38s]       set max_cpus 1
[03/17 23:58:34     38s]     }
