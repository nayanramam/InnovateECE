[03/17 21:52:33    372s]     #- Set DB for handoff to Innovus
[03/17 21:52:33    372s]     if {[is_flow -inside flow:syn_opt]} {
[03/17 21:52:33    372s]       set_db flow_write_db_common true
[03/17 21:52:33    372s]     }
[03/17 21:52:33    372s]   
[03/17 21:52:33    372s]     #- Set value for SPEF output file generation
[03/17 21:52:33    372s]     if {[get_db flow_branch] ne ""} {
[03/17 21:52:33    372s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
[03/17 21:52:33    372s]     } else {
[03/17 21:52:33    372s]       set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
[03/17 21:52:33    372s]     }
[03/17 21:52:33    372s]     set_db flow_spef_directory $out_dir
[03/17 21:52:33    372s]   
[03/17 21:52:33    372s]     #- Store non-default root attributes to metrics
[03/17 21:52:33    372s]     catch {report_obj -tcl} flow_root_config
[03/17 21:52:33    372s]     if {[dict exists $flow_root_config root:/]} {
[03/17 21:52:33    372s]       set flow_root_config [dict get $flow_root_config root:/]
[03/17 21:52:33    372s]     } elseif {[dict exists $flow_root_config root:]} {
[03/17 21:52:33    372s]       set flow_root_config [dict get $flow_root_config root:]
[03/17 21:52:33    372s]     } else {
[03/17 21:52:33    372s]     }
[03/17 21:52:33    372s]     foreach key [dict keys $flow_root_config] {
[03/17 21:52:33    372s]       if {[string length [dict get $flow_root_config $key]] > 200} {
[03/17 21:52:33    372s]         dict set flow_root_config $key "\[long value truncated\]"
[03/17 21:52:33    372s]       }
[03/17 21:52:33    372s]     }
[03/17 21:52:33    372s]     set_metric -name flow.root_config -value $flow_root_config
[03/17 21:52:33    372s]   }}
[03/17 21:52:33    372s] #@ End verbose flow_step implementation.postroute.block_finish
