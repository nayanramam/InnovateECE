[03/23 22:22:29     35s] @flow 2: apply {{} {
[03/23 22:22:29     35s]     # Multi host/cpu attributes
[03/23 22:22:29     35s]     #-----------------------------------------------------------------------------
[03/23 22:22:29     35s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/23 22:22:29     35s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/23 22:22:29     35s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/23 22:22:29     35s]     # a typical environment variable exported by distribution platforms and is
[03/23 22:22:29     35s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/23 22:22:29     35s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/23 22:22:29     35s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/23 22:22:29     35s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/23 22:22:29     35s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/23 22:22:29     35s]     } else {
[03/23 22:22:29     35s]       set max_cpus 1
[03/23 22:22:29     35s]     }
[03/23 22:22:29     35s]     switch -glob [get_db program_short_name] {
