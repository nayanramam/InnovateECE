[03/17 20:05:37     36s]   
[03/17 20:05:37     36s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/17 20:05:37     36s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/17 20:05:37     36s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/17 20:05:37     36s]         set cmd "set_analysis_view"
[03/17 20:05:37     36s]         if {$setup_views ne ""} {
[03/17 20:05:37     36s]           append cmd " -setup [list $setup_views]"
[03/17 20:05:37     36s]         } else {
[03/17 20:05:37     36s]           append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
[03/17 20:05:37     36s]         }
[03/17 20:05:37     36s]         if {$hold_views ne ""} {
[03/17 20:05:37     36s]           append cmd " -hold [list $hold_views]"
[03/17 20:05:37     36s]         } else {
