[03/17 21:23:47     35s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 21:23:47     35s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 21:23:47     35s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
