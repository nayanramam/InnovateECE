[03/17 21:09:38     42s]     #-----------------------------------------------------------------------------
[03/17 21:09:38     42s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/17 21:09:38     42s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/17 21:09:38     42s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/17 21:09:38     42s]     # a typical environment variable exported by distribution platforms and is
[03/17 21:09:38     42s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/17 21:09:38     42s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 21:09:38     42s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 21:09:38     42s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 21:09:38     42s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 21:09:38     42s]     } else {
