[03/17 21:09:27     33s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/17 21:09:27     33s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/17 21:09:27     33s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/17 21:09:27     33s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/17 21:09:27     33s]     } else {
[03/17 21:09:27     33s]       set max_cpus 1
[03/17 21:09:27     33s]     }
