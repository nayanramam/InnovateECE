[03/23 22:39:08     44s] #@ Begin verbose flow_step activate_views
[03/23 22:39:08     44s] @flow 2: apply {{} {
[03/23 22:39:08     44s]     set db [get_db flow_starting_db]
[03/23 22:39:08     44s]     set flow [lindex [get_db flow_hier_path] end]
[03/23 22:39:08     44s]     set setup_views [get_feature -obj $flow setup_views]
[03/23 22:39:08     44s]     set hold_views [get_feature -obj $flow hold_views]
[03/23 22:39:08     44s]     set leakage_view [get_feature -obj $flow leakage_view]
[03/23 22:39:08     44s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/23 22:39:08     44s]   
[03/23 22:39:08     44s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/23 22:39:08     44s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/23 22:39:08     44s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/23 22:39:08     44s]         set cmd "set_analysis_view"
[03/23 22:39:08     44s]         if {$setup_views ne ""} {
[03/23 22:39:08     44s]           append cmd " -setup [list $setup_views]"
[03/23 22:39:08     44s]         } else {
[03/23 22:39:08     44s]           append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
[03/23 22:39:08     44s]         }
[03/23 22:39:08     44s]         if {$hold_views ne ""} {
[03/23 22:39:08     44s]           append cmd " -hold [list $hold_views]"
[03/23 22:39:08     44s]         } else {
[03/23 22:39:08     44s]           append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
[03/23 22:39:08     44s]         }
[03/23 22:39:08     44s]         if {$leakage_view ne ""} {
[03/23 22:39:08     44s]           append cmd " -leakage [list $leakage_view]"
[03/23 22:39:08     44s]         } else {
[03/23 22:39:08     44s]           if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
[03/23 22:39:08     44s]             append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
[03/23 22:39:08     44s]           }
[03/23 22:39:08     44s]         }
[03/23 22:39:08     44s]         if {$dynamic_view ne ""} {
[03/23 22:39:08     44s]           append cmd " -dynamic [list $dynamic_view]"
[03/23 22:39:08     44s]         } else {
[03/23 22:39:08     44s]           if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
