floorplan:@file 11: foreach i $mem_blocks {
floorplan:    puts $i
floorplan:    connect_global_net VDD -type pgpin -pin vccd1 -sinst $i -override
floorplan:    connect_global_net VSS -type pgpin -pin vssd1 -sinst $i -override
floorplan:}
