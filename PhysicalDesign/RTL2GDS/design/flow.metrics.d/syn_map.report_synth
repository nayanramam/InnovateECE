 {[string length [dict get $flow_root_config $key]] > 200} {\n        dict set flow_root_config $key \"\\[long value truncated\\]\"\n      }\n    }\n    set_metric -name flow.root_config -value $flow_root_config\n  }}"},{"name":"flow.template.type","value":"stylus"},{"name":"flow.tool.name","value":"Genus(TM) Synthesis Solution"},{"name":"flow.tool.name.short","value":"genus"},{"name":"flow.tool.version","value":"25.11-s095_1"},{"inherited":true,"name":"flow.tool_list","value":"genus-25.11-s095_1"},{"name":"flow.user","value":"dkhalil8"},{"inherited":true,"name":"metric.version","value":"1"},{"name":"metric.version.instant","value":"1"},{"name":"name","value":"block_finish"},{"inherited":true,"name":"uuid","value":"3a0a81ce-82c3-4741-bb16-0233b1e69f19"}],"name":"block_finish","parent_key":"flow:flow_current .steps flow:synthesis .steps flow:syn_map","path":"syn_map/block_finish","previous":["018f7687-3672-4411-977b-941de518e82d","c211d509-b4cb-4f04-af0d-bf096d2750b6","6bd9ccfa-5aa3-4885-821b-f52c912e305d"],"real_end":1774316460.0,"real_start":1774316457.0,"snapshots":[{"branch":"default","delta_cpu":1.0,"delta_cpu_not_child":1.0,"delta_cpu_user":1.0,"delta_cpu_user_not_child":1.0,"delta_real_not_child":1.0,"exclude_time_metric":true,"key":"flow:flow_current .steps flow:synthesis .steps flow:syn_map .steps flow_step:block_finish {.write_db write_db}","metrics":[{"name":"flow.branch","value":"default"},{"inherited":true,"name":"flow.cputime","value":"1"},{"inherited":true,"name":"flow.cputime.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.total","value":"436"},{"inherited":true,"name":"flow.cputime.user","value":"1"},{"inherited":true,"name":"flow.cputime.user.not_child","value":"1"},{"inherited":true,"name":"flow.cputime.user.total","value":"436"},{"name":"flow.exclude_time_metric","value":"1"},{"name":"flow.machine.load","value":"6.34"},{"inherited":true,"name":"flow.memory","value":"969.017 MB"},{"name":"flow.memory.instant","value":"969.017 MB"},{"