syn_opt:#@ Begin verbose flow_step init_mcpu
syn_opt:@flow_step(init_mcpu)  2:   apply {{} {
syn_opt:                              # Multi host/cpu attributes
syn_opt:                              #-----------------------------------------------------------------------------
syn_opt:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_opt:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_opt:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_opt:                              # a typical environment variable exported by distribution platforms and is
syn_opt:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_opt:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_opt:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_opt:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_opt:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_opt:                              } else {
syn_opt:                                set max_cpus 1
syn_opt:                              }
syn_opt:                              switch -glob [get_db program_short_name] {
syn_opt:                                default       {}
syn_opt:                                joules*       -
syn_opt:                                genus*        -
syn_opt:                                innovus*      -
syn_opt:                                tempus*       -
syn_opt:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_opt:                              }
syn_opt:                          if {[get_feature opt_signoff]} {
syn_opt:                                if {[is_flow -inside flow:opt_signoff]} {
syn_opt:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_opt:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_opt:                                  set_distributed_hosts -local
syn_opt:                                }
syn_opt:                          }
syn_opt:                            }}
syn_opt:set_multi_cpu_usage -local_cpu 1
syn_opt:#@ End verbose flow_step init_mcpu
syn_opt:End steps for plugin point Cadence.plugin.flowkit.read_db.post
syn_opt:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_opt:UM:*                                                                   init_flow
syn_opt:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_opt:UM:*                                                                   syn_opt
syn_opt:  Setting attribute of root '/': 'flow_report_name' = syn_opt
syn_opt:#@ Begin verbose flow_step synthesis.syn_opt.block_start
syn_opt:@flow_step(block_start)  2:   set_db flow_write_db_common false
syn_opt:  Setting attribute of root '/': 'flow_write_db_common' = false
syn_opt:@flow_step(block_start)  3:   # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
syn_opt:@flow_step(block_start)  4:   # Genus blocks also read rc DBs but are at initialization_complete already,
syn_opt:@flow_step(block_start)  5:   # so we guard with program_short_name to avoid TUI-340 in Genus.
syn_opt:@flow_step(block_start)  6:   if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {
syn_opt:                                set_db init_ground_nets [get_flow_config init_ground_nets]
syn_opt:                                set_db init_power_nets  [get_flow_config init_power_nets]
syn_opt:                                read_physical -lef [get_flow_config init_physical_files lef_files]
syn_opt:                                # Derive paths from genus_to_innovus write_design output: dbs/<syn_step>/<design>.*
syn_opt:                                set _syn_db [dict get [get_db flow_starting_db] rc]
syn_opt:                                set _syn_step [file rootname [file tail $_syn_db]]
syn_opt:                                set _base [file join [get_db flow_db_directory] $_syn_step [get_flow_config design_name]]
syn_opt:                                read_mmmc ${_base}.mmmc.tcl
syn_opt:                                read_netlist ${_base}.v.gz -top [get_flow_config design_name]
syn_opt:                                init_design
syn_opt:                              }
syn_opt:#@ End verbose flow_step synthesis.syn_opt.block_start
syn_opt:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_opt:UM:             34             39                                      block_start
