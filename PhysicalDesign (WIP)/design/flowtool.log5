syn_map.report_synth:  #- extend flow report name based on context
syn_map.report_synth:  if {[is_flow -quiet -inside flow:sta] || [is_flow -quiet -inside flow:sta_dmmmc] || [is_flow -quiet -inside flow:sta_eco]} {
