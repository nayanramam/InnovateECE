syn_generic:#@ Begin verbose flow_step synthesis.syn_generic.init_design.read_physical
syn_generic:@flow_step(read_physical)  2:   apply {{} {
syn_generic:                                  if {![string is space [get_flow_config -quiet init_physical_files lef_files]]} {
syn_generic:                                    read_physical -lef [get_flow_config init_physical_files lef_files]
syn_generic:                                  }
syn_generic:                                  if {![string is space [get_flow_config -quiet init_physical_files oa_ref_libs]]} {
syn_generic:                                    set flow_startup_directory [get_db flow_startup_directory]
syn_generic:                                    set flow_top_directory [file normalize [get_db flow_working_directory]]
syn_generic:                                    if {![string is space [get_flow_config -quiet init_physical_files oa_search_libs]]} {
syn_generic:                                      set cmd "[list read_physical -oa_ref_libs [get_flow_config init_physical_files oa_ref_libs] -oa_search_libs [get_flow_config init_physical_files oa_search_libs]]"
syn_generic:                                    } else {
syn_generic:                                      set cmd "[list read_physical -oa_ref_libs [get_flow_config init_physical_files oa_ref_libs]]"
syn_generic:                                    }
syn_generic:                                
syn_generic:                                    if {$flow_startup_directory ne $flow_top_directory} {
syn_generic:                                      cd $flow_startup_directory
syn_generic:                                      eval $cmd
syn_generic:                                      cd $flow_top_directory
syn_generic:                                    } else {
syn_generic:                                      eval $cmd
syn_generic:                                    }
syn_generic:                                  }
syn_generic:                                }}
