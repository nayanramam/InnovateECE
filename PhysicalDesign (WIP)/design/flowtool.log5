syn_generic:Begin steps for plugin point Cadence.plugin.flowkit.read_db.pre
syn_generic:#@ Begin verbose flow_step activate_views
syn_generic:@flow_step(activate_views)  2:   apply {{} {
syn_generic:                                   set db [get_db flow_starting_db]
syn_generic:                                   set flow [lindex [get_db flow_hier_path] end]
syn_generic:                                   set setup_views [get_feature -obj $flow setup_views]
syn_generic:                                   set hold_views [get_feature -obj $flow hold_views]
syn_generic:                                   set leakage_view [get_feature -obj $flow leakage_view]
syn_generic:                                   set dynamic_view [get_feature -obj $flow dynamic_view]
syn_generic:                                 
syn_generic:                                   if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_generic:                                     #- use read_db args for DB types and set_analysis_views for TCL
syn_generic:                                     if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
syn_generic:                                       set cmd "set_analysis_view"
syn_generic:                                       if {$setup_views ne ""} {
syn_generic:                                         append cmd " -setup [list $setup_views]"
syn_generic:                                       } else {
syn_generic:                                         append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_generic:                                       }
syn_generic:                                       if {$hold_views ne ""} {
syn_generic:                                         append cmd " -hold [list $hold_views]"
syn_generic:                                       } else {
syn_generic:                                         append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_generic:                                       }
syn_generic:                                       if {$leakage_view ne ""} {
syn_generic:                                         append cmd " -leakage [list $leakage_view]"
syn_generic:                                       } else {
syn_generic:                                         if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_generic:                                           append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_generic:                                         }
syn_generic:                                       }
syn_generic:                                       if {$dynamic_view ne ""} {
syn_generic:                                         append cmd " -dynamic [list $dynamic_view]"
syn_generic:                                       } else {
syn_generic:                                         if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_generic:                                           append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_generic:                                         }
syn_generic:                                       }
syn_generic:                                       eval $cmd
syn_generic:                                     } elseif {[llength [get_db analysis_views]] == 0} {
syn_generic:                                       set cmd "set_flowkit_read_db_args"
syn_generic:                                       if {$setup_views ne ""} {
syn_generic:                                         append cmd " -setup_views [list $setup_views]"
syn_generic:                                       }
syn_generic:                                       if {$hold_views ne ""} {
syn_generic:                                         append cmd " -hold_views [list $hold_views]"
syn_generic:                                       }
syn_generic:                                       if {$leakage_view ne ""} {
syn_generic:                                         append cmd " -leakage_view [list $leakage_view]"
syn_generic:                                       }
syn_generic:                                       if {$dynamic_view ne ""} {
syn_generic:                                         append cmd " -dynamic_view [list $dynamic_view]"
syn_generic:                                       }
syn_generic:                                       eval $cmd
syn_generic:                                     } else {
syn_generic:                                     }
syn_generic:                                   }
syn_generic:                                 }}
syn_generic:#@ End verbose flow_step activate_views
syn_generic:#@ Begin verbose flow_step init_mcpu
syn_generic:@flow_step(init_mcpu)  2:   apply {{} {
syn_generic:                              # Multi host/cpu attributes
syn_generic:                              #-----------------------------------------------------------------------------
syn_generic:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_generic:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_generic:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_generic:                              # a typical environment variable exported by distribution platforms and is
syn_generic:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_generic:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_generic:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_generic:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_generic:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_generic:                              } else {
syn_generic:                                set max_cpus 1
syn_generic:                              }
syn_generic:                              switch -glob [get_db program_short_name] {
syn_generic:                                default       {}
syn_generic:                                joules*       -
syn_generic:                                genus*        -
syn_generic:                                innovus*      -
syn_generic:                                tempus*       -
syn_generic:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_generic:                              }
syn_generic:                          if {[get_feature opt_signoff]} {
syn_generic:                                if {[is_flow -inside flow:opt_signoff]} {
syn_generic:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_generic:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_generic:                                  set_distributed_hosts -local
syn_generic:                                }
syn_generic:                          }
syn_generic:                            }}
syn_generic:set_multi_cpu_usage -local_cpu 1
syn_generic:#@ End verbose flow_step init_mcpu
syn_generic:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
