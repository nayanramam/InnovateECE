syn_opt:#@ Begin verbose flow_step synthesis.syn_opt.block_finish
syn_opt:@flow_step(block_finish)  2:   apply {{} {
syn_opt:                                 set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
syn_opt:                                 if {[is_flow -inside flow:syn_opt] && [get_feature use_common_db]} {
syn_opt:                                   set_db flow_write_db_common true
syn_opt:                                 }
syn_opt:                                 if {[get_db flow_branch] ne ""} {
syn_opt:                                   set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
syn_opt:                                 } else {
syn_opt:                                   set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
syn_opt:                                 }
syn_opt:                                 set_db flow_spef_directory $out_dir
syn_opt:                                 catch {report_obj -tcl} flow_root_config
syn_opt:                                 if {[dict exists $flow_root_config root:/]} {
syn_opt:                                   set flow_root_config [dict get $flow_root_config root:/]
syn_opt:                                 } elseif {[dict exists $flow_root_config root:]} {
syn_opt:                                   set flow_root_config [dict get $flow_root_config root:]
syn_opt:                                 } else {
syn_opt:                                 }
syn_opt:                                 foreach key [dict keys $flow_root_config] {
syn_opt:                                   if {[string length [dict get $flow_root_config $key]] > 200} {
syn_opt:                                     dict set flow_root_config $key "\[long value truncated\]"
syn_opt:                                   }
syn_opt:                                 }
syn_opt:                                 set_metric -name flow.root_config -value $flow_root_config
syn_opt:                               }}
syn_opt:  Setting attribute of root '/': 'flow_report_name' = syn_opt
syn_opt:  Setting attribute of root '/': 'flow_spef_directory' = dbs/syn_opt
syn_opt:#@ End verbose flow_step synthesis.syn_opt.block_finish
syn_opt:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_opt:UM:              3              3                                      block_finish
syn_map.report_synth:#@ Begin verbose flow_step report_late_paths
syn_map.report_synth:@flow_step(report_late_paths)  2:   #- Reports that show detailed timing with Graph Based Analysis (GBA)
syn_map.report_synth:@flow_step(report_late_paths)  3:   report_timing -max_paths 5   -nworst 1 -path_type endpoint        > [file join [get_db flow_report_directory] [get_db flow_report_name] setup.endpoint.rpt]
