prects:#@ Begin verbose flow_step implementation.prects.block_start
prects:@@flow 2: set_db flow_write_db_common false
prects:@flow 3: # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
floorplan.report_floorplan:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
floorplan.report_floorplan:UM:*                                                                   report_floorplan
prects:@flow 4: # Genus blocks also read rc DBs but are at initialization_complete already,
prects:@flow 5: # so we guard with program_short_name to avoid TUI-340 in Genus.
prects:@flow 6: if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {...}
prects:#@ End verbose flow_step implementation.prects.block_start
