syn_map:#@ Begin verbose flow_step synthesis.syn_map.block_start
syn_map:@flow_step(block_start)  2:   set_db flow_write_db_common false
syn_map:  Setting attribute of root '/': 'flow_write_db_common' = false
syn_map:@flow_step(block_start)  3:   # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
syn_map:@flow_step(block_start)  4:   # Genus blocks also read rc DBs but are at initialization_complete already,
syn_map:@flow_step(block_start)  5:   # so we guard with program_short_name to avoid TUI-340 in Genus.
syn_map:@flow_step(block_start)  6:   if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {
syn_map:                                set_db init_ground_nets [get_flow_config init_ground_nets]
syn_map:                                set_db init_power_nets  [get_flow_config init_power_nets]
syn_map:                                read_physical -lef [get_flow_config init_physical_files lef_files]
syn_map:                                # Derive paths from genus_to_innovus write_design output: dbs/<syn_step>/<design>.*
syn_map:                                set _syn_db [dict get [get_db flow_starting_db] rc]
syn_map:                                set _syn_step [file rootname [file tail $_syn_db]]
syn_map:                                set _base [file join [get_db flow_db_directory] $_syn_step [get_flow_config design_name]]
syn_map:                                read_mmmc ${_base}.mmmc.tcl
syn_map:                                read_netlist ${_base}.v.gz -top [get_flow_config design_name]
syn_map:                                init_design
syn_map:                              }
syn_map:#@ End verbose flow_step synthesis.syn_map.block_start
