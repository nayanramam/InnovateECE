syn_generic.report_synth:  #- extend flow report name based on context
syn_generic.report_synth:  if {[is_flow -quiet -inside flow:sta] || [is_flow -quiet -inside flow:sta_dmmmc] || [is_flow -quiet -inside flow:sta_eco]} {
syn_generic.report_synth:    if {![regexp {sta$} [get_db flow_report_name]]} {
syn_generic.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "sta" : "[get_db flow_report_name].sta"}]
syn_generic.report_synth:    }
syn_generic.report_synth:  } elseif {[is_flow -quiet -inside flow:ir_early_static] || [is_flow -quiet -inside flow:ir_early_dynamic]} {
syn_generic.report_synth:    if {![regexp {era$} [get_db flow_report_name]]} {
syn_generic.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "era" : "[get_db flow_report_name].era"}]
syn_generic.report_synth:    }
syn_generic.report_synth:  } elseif {[is_flow -quiet -inside flow:ir_grid] || [is_flow -quiet -inside flow:ir_static] || [is_flow -quiet -inside flow:ir_dynamic] || [is_flow -quiet -inside flow:ir_rampup]} {
syn_generic.report_synth:    if {![regexp {ir$} [get_db flow_report_name]]} {
syn_generic.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "ir" : "[get_db flow_report_name].ir"}]
syn_generic.report_synth:    }
syn_generic.report_synth:  } elseif {[is_flow -quiet -inside flow:sta_subflows] && [get_db flow_branch] ne {}} {
syn_generic.report_synth:    set_db flow_report_name [get_db flow_branch]
syn_generic.report_synth:  } elseif {[regexp {block_start|hier_start|eco_start} [get_db flow_step_current]]} {
syn_generic.report_synth:    set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
syn_generic.report_synth:  } else {
syn_generic.report_synth:  }
syn_generic.report_synth:
syn_generic.report_synth:  #- Create report dir (if necessary)
syn_generic.report_synth:  file mkdir [file normalize [file join [get_db flow_report_directory] [get_db flow_report_name]]]
syn_generic.report_synth:
syn_generic.report_synth:  Setting attribute of root '/': 'flow_top' = flow:block
syn_generic.report_synth:  Setting attribute of root '/': 'flow_top' = flow_current
syn_generic.report_synth:Sourcing flow scripts done.
syn_generic.report_synth:Begin steps for plugin point Cadence.plugin.flowkit.read_db.pre
syn_generic.report_synth:#@ Begin verbose flow_step activate_views
syn_generic.report_synth:@flow_step(activate_views)  2:   apply {{} {
syn_generic.report_synth:                                   set db [get_db flow_starting_db]
syn_generic.report_synth:                                   set flow [lindex [get_db flow_hier_path] end]
syn_generic.report_synth:                                   set setup_views [get_feature -obj $flow setup_views]
syn_generic.report_synth:                                   set hold_views [get_feature -obj $flow hold_views]
syn_generic.report_synth:                                   set leakage_view [get_feature -obj $flow leakage_view]
syn_generic.report_synth:                                   set dynamic_view [get_feature -obj $flow dynamic_view]
syn_generic.report_synth:                                 
syn_generic.report_synth:                                   if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_generic.report_synth:                                     #- use read_db args for DB types and set_analysis_views for TCL
syn_generic.report_synth:                                     if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
syn_generic.report_synth:                                       set cmd "set_analysis_view"
syn_generic.report_synth:                                       if {$setup_views ne ""} {
syn_generic.report_synth:                                         append cmd " -setup [list $setup_views]"
syn_generic.report_synth:                                       } else {
syn_generic.report_synth:                                         append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$hold_views ne ""} {
syn_generic.report_synth:                                         append cmd " -hold [list $hold_views]"
syn_generic.report_synth:                                       } else {
syn_generic.report_synth:                                         append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$leakage_view ne ""} {
syn_generic.report_synth:                                         append cmd " -leakage [list $leakage_view]"
syn_generic.report_synth:                                       } else {
syn_generic.report_synth:                                         if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_generic.report_synth:                                           append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_generic.report_synth:                                         }
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$dynamic_view ne ""} {
syn_generic.report_synth:                                         append cmd " -dynamic [list $dynamic_view]"
syn_generic.report_synth:                                       } else {
syn_generic.report_synth:                                         if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_generic.report_synth:                                           append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_generic.report_synth:                                         }
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       eval $cmd
syn_generic.report_synth:                                     } elseif {[llength [get_db analysis_views]] == 0} {
syn_generic.report_synth:                                       set cmd "set_flowkit_read_db_args"
syn_generic.report_synth:                                       if {$setup_views ne ""} {
syn_generic.report_synth:                                         append cmd " -setup_views [list $setup_views]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$hold_views ne ""} {
syn_generic.report_synth:                                         append cmd " -hold_views [list $hold_views]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$leakage_view ne ""} {
syn_generic.report_synth:                                         append cmd " -leakage_view [list $leakage_view]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       if {$dynamic_view ne ""} {
syn_generic.report_synth:                                         append cmd " -dynamic_view [list $dynamic_view]"
syn_generic.report_synth:                                       }
syn_generic.report_synth:                                       eval $cmd
syn_generic.report_synth:                                     } else {
syn_generic.report_synth:                                     }
syn_generic.report_synth:                                   }
syn_generic.report_synth:                                 }}
syn_generic.report_synth:#@ End verbose flow_step activate_views
syn_generic.report_synth:#@ Begin verbose flow_step init_mcpu
syn_generic.report_synth:@flow_step(init_mcpu)  2:   apply {{} {
syn_generic.report_synth:                              # Multi host/cpu attributes
syn_generic.report_synth:                              #-----------------------------------------------------------------------------
syn_generic.report_synth:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_generic.report_synth:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_generic.report_synth:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_generic.report_synth:                              # a typical environment variable exported by distribution platforms and is
syn_generic.report_synth:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_generic.report_synth:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_generic.report_synth:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_generic.report_synth:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_generic.report_synth:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_generic.report_synth:                              } else {
syn_generic.report_synth:                                set max_cpus 1
syn_generic.report_synth:                              }
syn_generic.report_synth:                              switch -glob [get_db program_short_name] {
syn_generic.report_synth:                                default       {}
syn_generic.report_synth:                                joules*       -
syn_generic.report_synth:                                genus*        -
syn_generic.report_synth:                                innovus*      -
syn_generic.report_synth:                                tempus*       -
syn_generic.report_synth:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_generic.report_synth:                              }
syn_generic.report_synth:                          if {[get_feature opt_signoff]} {
syn_generic.report_synth:                                if {[is_flow -inside flow:opt_signoff]} {
syn_generic.report_synth:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_generic.report_synth:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_generic.report_synth:                                  set_distributed_hosts -local
syn_generic.report_synth:                                }
syn_generic.report_synth:                          }
syn_generic.report_synth:                            }}
syn_generic.report_synth:set_multi_cpu_usage -local_cpu 1
syn_generic.report_synth:#@ End verbose flow_step init_mcpu
syn_generic.report_synth:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
