#@ Begin verbose flow_step implementation.floorplan.block_start
@@flow 2: set_db flow_write_db_common false
@flow 3: # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
@flow 4: # Genus blocks also read rc DBs but are at initialization_complete already,
@flow 5: # so we guard with program_short_name to avoid TUI-340 in Genus.
