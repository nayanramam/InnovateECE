[03/13 11:00:17     34s]         if {$leakage_view ne ""} {
[03/13 11:00:17     34s]           append cmd " -leakage_view [list $leakage_view]"
[03/13 11:00:17     34s]         }
[03/13 11:00:17     34s]         if {$dynamic_view ne ""} {
[03/13 11:00:17     34s]           append cmd " -dynamic_view [list $dynamic_view]"
[03/13 11:00:17     34s]         }
[03/13 11:00:17     34s]         eval $cmd
[03/13 11:00:17     34s]       } else {
[03/13 11:00:17     34s]       }
[03/13 11:00:17     34s]     }
[03/13 11:00:17     34s]   }}
[03/13 11:00:17     34s] #@ End verbose flow_step activate_views
[03/13 11:00:17     34s] #@ Begin verbose flow_step init_mcpu
[03/13 11:00:17     34s] @flow 2: apply {{} {
[03/13 11:00:17     34s]     # Multi host/cpu attributes
[03/13 11:00:17     34s]     #-----------------------------------------------------------------------------
[03/13 11:00:17     34s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/13 11:00:17     34s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/13 11:00:17     34s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/13 11:00:17     34s]     # a typical environment variable exported by distribution platforms and is
[03/13 11:00:17     34s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/13 11:00:17     34s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/13 11:00:17     34s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/13 11:00:17     34s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/13 11:00:17     34s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/13 11:00:17     34s]     } else {
[03/13 11:00:17     34s]       set max_cpus 1
[03/13 11:00:17     34s]     }
[03/13 11:00:17     34s]     switch -glob [get_db program_short_name] {
[03/13 11:00:17     34s]       default       {}
[03/13 11:00:17     34s]       joules*       -
[03/13 11:00:17     34s]       genus*        -
[03/13 11:00:17     34s]       innovus*      -
[03/13 11:00:17     34s]       tempus*       -
[03/13 11:00:17     34s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/13 11:00:17     34s]     }
[03/13 11:00:17     34s] if {[get_feature opt_signoff]} {
[03/13 11:00:17     34s]       if {[is_flow -inside flow:opt_signoff]} {
[03/13 11:00:17     34s]         set_multi_cpu_usage -verbose -remote_host 1
[03/13 11:00:17     34s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/13 11:00:17     34s]         set_distributed_hosts -local
[03/13 11:00:17     34s]       }
[03/13 11:00:17     34s] }
[03/13 11:00:17     34s]   }}
[03/13 11:00:17     34s] set_multi_cpu_usage -local_cpu 1
[03/13 11:00:17     34s] #@ End verbose flow_step init_mcpu
[03/13 11:00:17     34s] End steps for plugin point Cadence.plugin.flowkit.read_db.post
