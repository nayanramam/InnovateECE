[03/13 11:00:15     32s]     #-----------------------------------------------------------------------------
[03/13 11:00:15     32s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/13 11:00:15     32s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/13 11:00:15     32s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/13 11:00:15     32s]     # a typical environment variable exported by distribution platforms and is
[03/13 11:00:15     32s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/13 11:00:15     32s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/13 11:00:15     32s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/13 11:00:15     32s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/13 11:00:15     32s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/13 11:00:15     32s]     } else {
[03/13 11:00:15     32s]       set max_cpus 1
[03/13 11:00:15     32s]     }
[03/13 11:00:15     32s]     switch -glob [get_db program_short_name] {
[03/13 11:00:15     32s]       default       {}
[03/13 11:00:15     32s]       joules*       -
[03/13 11:00:15     32s]       genus*        -
[03/13 11:00:15     32s]       innovus*      -
[03/13 11:00:15     32s]       tempus*       -
[03/13 11:00:15     32s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/13 11:00:15     32s]     }
[03/13 11:00:15     32s] if {[get_feature opt_signoff]} {
