#@ Begin verbose flow_step synthesis.syn_generic.block_start
@flow_step(block_start)  2:   set_db flow_write_db_common false
  Setting attribute of root '/': 'flow_write_db_common' = false
@flow_step(block_start)  3:   # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
@flow_step(block_start)  4:   # Genus blocks also read rc DBs but are at initialization_complete already,
@flow_step(block_start)  5:   # so we guard with program_short_name to avoid TUI-340 in Genus.
@flow_step(block_start)  6:   if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {
                                set_db init_ground_nets [get_flow_config init_ground_nets]
                                set_db init_power_nets  [get_flow_config init_power_nets]
                                read_physical -lef [get_flow_config init_physical_files lef_files]
                                init_design
                              }
#@ End verbose flow_step synthesis.syn_generic.block_start
      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
