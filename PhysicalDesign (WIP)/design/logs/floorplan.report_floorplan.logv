[03/13 11:13:01     41s] #@ Begin verbose flow_step activate_views
[03/13 11:13:01     41s] @flow 2: apply {{} {
[03/13 11:13:01     41s]     set db [get_db flow_starting_db]
[03/13 11:13:01     41s]     set flow [lindex [get_db flow_hier_path] end]
[03/13 11:13:01     41s]     set setup_views [get_feature -obj $flow setup_views]
[03/13 11:13:01     41s]     set hold_views [get_feature -obj $flow hold_views]
[03/13 11:13:01     41s]     set leakage_view [get_feature -obj $flow leakage_view]
[03/13 11:13:01     41s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/13 11:13:01     41s]   
[03/13 11:13:01     41s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/13 11:13:01     41s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/13 11:13:01     41s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/13 11:13:01     41s]         set cmd "set_analysis_view"
[03/13 11:13:01     41s]         if {$setup_views ne ""} {
[03/13 11:13:01     41s]           append cmd " -setup [list $setup_views]"
[03/13 11:13:01     41s]         } else {
[03/13 11:13:01     41s]           append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$hold_views ne ""} {
[03/13 11:13:01     41s]           append cmd " -hold [list $hold_views]"
[03/13 11:13:01     41s]         } else {
[03/13 11:13:01     41s]           append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$leakage_view ne ""} {
[03/13 11:13:01     41s]           append cmd " -leakage [list $leakage_view]"
[03/13 11:13:01     41s]         } else {
[03/13 11:13:01     41s]           if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
[03/13 11:13:01     41s]             append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
[03/13 11:13:01     41s]           }
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$dynamic_view ne ""} {
[03/13 11:13:01     41s]           append cmd " -dynamic [list $dynamic_view]"
[03/13 11:13:01     41s]         } else {
[03/13 11:13:01     41s]           if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
[03/13 11:13:01     41s]             append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
[03/13 11:13:01     41s]           }
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         eval $cmd
[03/13 11:13:01     41s]       } elseif {[llength [get_db analysis_views]] == 0} {
[03/13 11:13:01     41s]         set cmd "set_flowkit_read_db_args"
[03/13 11:13:01     41s]         if {$setup_views ne ""} {
[03/13 11:13:01     41s]           append cmd " -setup_views [list $setup_views]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$hold_views ne ""} {
[03/13 11:13:01     41s]           append cmd " -hold_views [list $hold_views]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$leakage_view ne ""} {
[03/13 11:13:01     41s]           append cmd " -leakage_view [list $leakage_view]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         if {$dynamic_view ne ""} {
[03/13 11:13:01     41s]           append cmd " -dynamic_view [list $dynamic_view]"
[03/13 11:13:01     41s]         }
[03/13 11:13:01     41s]         eval $cmd
[03/13 11:13:01     41s]       } else {
[03/13 11:13:01     41s]       }
[03/13 11:13:01     41s]     }
[03/13 11:13:01     41s]   }}
[03/13 11:13:01     41s] #@ End verbose flow_step activate_views
[03/13 11:13:01     41s] #@ Begin verbose flow_step init_mcpu
[03/13 11:13:01     41s] @flow 2: apply {{} {
[03/13 11:13:01     41s]     # Multi host/cpu attributes
[03/13 11:13:01     41s]     #-----------------------------------------------------------------------------
[03/13 11:13:01     41s]     # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
[03/13 11:13:01     41s]     # the specified dist script.  This connects the number of CPUs being reserved
[03/13 11:13:01     41s]     # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
[03/13 11:13:01     41s]     # a typical environment variable exported by distribution platforms and is
[03/13 11:13:01     41s]     # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
[03/13 11:13:01     41s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/13 11:13:01     41s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/13 11:13:01     41s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
[03/13 11:13:01     41s]       set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
[03/13 11:13:01     41s]     } else {
[03/13 11:13:01     41s]       set max_cpus 1
[03/13 11:13:01     41s]     }
[03/13 11:13:01     41s]     switch -glob [get_db program_short_name] {
[03/13 11:13:01     41s]       default       {}
[03/13 11:13:01     41s]       joules*       -
[03/13 11:13:01     41s]       genus*        -
[03/13 11:13:01     41s]       innovus*      -
[03/13 11:13:01     41s]       tempus*       -
[03/13 11:13:01     41s]       voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
[03/13 11:13:01     41s]     }
[03/13 11:13:01     41s] if {[get_feature opt_signoff]} {
[03/13 11:13:01     41s]       if {[is_flow -inside flow:opt_signoff]} {
[03/13 11:13:01     41s]         set_multi_cpu_usage -verbose -remote_host 1
[03/13 11:13:01     41s]         set_multi_cpu_usage -verbose -cpu_per_remote_host 16
[03/13 11:13:01     41s]         set_distributed_hosts -local
[03/13 11:13:01     41s]       }
[03/13 11:13:01     41s] }
[03/13 11:13:01     41s]   }}
[03/13 11:13:01     41s] set_multi_cpu_usage -local_cpu 1
[03/13 11:13:01     41s] #@ End verbose flow_step init_mcpu
[03/13 11:13:01     41s] End steps for plugin point Cadence.plugin.flowkit.read_db.post
