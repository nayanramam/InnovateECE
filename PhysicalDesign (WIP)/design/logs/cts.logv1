[03/13 11:39:52     41s]         }
[03/13 11:39:52     41s]         if {$hold_views ne ""} {
[03/13 11:39:52     41s]           append cmd " -hold [list $hold_views]"
[03/13 11:39:52     41s]         } else {
[03/13 11:39:52     41s]           append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
[03/13 11:39:52     41s]         }
[03/13 11:39:52     41s]         if {$leakage_view ne ""} {
[03/13 11:39:52     41s]           append cmd " -leakage [list $leakage_view]"
[03/13 11:39:52     41s]         } else {
