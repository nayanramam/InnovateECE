[03/13 11:39:52     41s]     set dynamic_view [get_feature -obj $flow dynamic_view]
[03/13 11:39:52     41s]   
[03/13 11:39:52     41s]     if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
[03/13 11:39:52     41s]       #- use read_db args for DB types and set_analysis_views for TCL
[03/13 11:39:52     41s]       if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
[03/13 11:39:52     41s]         set cmd "set_analysis_view"
[03/13 11:39:52     41s]         if {$setup_views ne ""} {
[03/13 11:39:52     41s]           append cmd " -setup [list $setup_views]"
[03/13 11:39:52     41s]         } else {
