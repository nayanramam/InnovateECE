[03/13 11:12:52     33s]     if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
[03/13 11:12:52     33s]       set max_cpus $::env(FLOWTOOL_NUM_CPUS)
[03/13 11:12:52     33s]     } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
