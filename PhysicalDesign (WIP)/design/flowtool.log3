syn_map.report_synth:  #- extend flow report name based on context
syn_map.report_synth:  if {[is_flow -quiet -inside flow:sta] || [is_flow -quiet -inside flow:sta_dmmmc] || [is_flow -quiet -inside flow:sta_eco]} {
syn_map.report_synth:    if {![regexp {sta$} [get_db flow_report_name]]} {
syn_map.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "sta" : "[get_db flow_report_name].sta"}]
syn_map.report_synth:    }
syn_map.report_synth:  } elseif {[is_flow -quiet -inside flow:ir_early_static] || [is_flow -quiet -inside flow:ir_early_dynamic]} {
syn_map.report_synth:    if {![regexp {era$} [get_db flow_report_name]]} {
syn_map.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "era" : "[get_db flow_report_name].era"}]
syn_map.report_synth:    }
syn_map.report_synth:  } elseif {[is_flow -quiet -inside flow:ir_grid] || [is_flow -quiet -inside flow:ir_static] || [is_flow -quiet -inside flow:ir_dynamic] || [is_flow -quiet -inside flow:ir_rampup]} {
syn_map.report_synth:    if {![regexp {ir$} [get_db flow_report_name]]} {
syn_map.report_synth:      set_db flow_report_name [expr {[string is space [get_db flow_report_name]] ? "ir" : "[get_db flow_report_name].ir"}]
syn_map.report_synth:    }
syn_map.report_synth:  } elseif {[is_flow -quiet -inside flow:sta_subflows] && [get_db flow_branch] ne {}} {
syn_map.report_synth:    set_db flow_report_name [get_db flow_branch]
syn_map.report_synth:  } elseif {[regexp {block_start|hier_start|eco_start} [get_db flow_step_current]]} {
syn_map.report_synth:    set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
syn_map.report_synth:  } else {
syn_map.report_synth:  }
