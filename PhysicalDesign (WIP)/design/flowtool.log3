syn_opt.report_synth:                                         }
syn_opt.report_synth:                                       }
syn_opt.report_synth:                                       if {$dynamic_view ne ""} {
syn_opt.report_synth:                                         append cmd " -dynamic [list $dynamic_view]"
syn_opt.report_synth:                                       } else {
syn_opt.report_synth:                                         if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_opt.report_synth:                                           append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_opt.report_synth:                                         }
syn_opt.report_synth:                                       }
syn_opt.report_synth:                                       eval $cmd
syn_opt.report_synth:                                     } elseif {[llength [get_db analysis_views]] == 0} {
syn_opt.report_synth:                                       set cmd "set_flowkit_read_db_args"
