syn_map.report_synth:#@ Begin verbose flow_step init_mcpu
syn_map.report_synth:@flow_step(init_mcpu)  2:   apply {{} {
syn_map.report_synth:                              # Multi host/cpu attributes
syn_map.report_synth:                              #-----------------------------------------------------------------------------
syn_map.report_synth:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_map.report_synth:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_map.report_synth:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_map.report_synth:                              # a typical environment variable exported by distribution platforms and is
syn_map.report_synth:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_map.report_synth:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_map.report_synth:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_map.report_synth:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_map.report_synth:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_map.report_synth:                              } else {
syn_map.report_synth:                                set max_cpus 1
syn_map.report_synth:                              }
syn_map.report_synth:                              switch -glob [get_db program_short_name] {
syn_map.report_synth:                                default       {}
syn_map.report_synth:                                joules*       -
syn_map.report_synth:                                genus*        -
syn_map.report_synth:                                innovus*      -
syn_map.report_synth:                                tempus*       -
syn_map.report_synth:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_map.report_synth:                              }
syn_map.report_synth:                          if {[get_feature opt_signoff]} {
syn_map.report_synth:                                if {[is_flow -inside flow:opt_signoff]} {
syn_map.report_synth:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_map.report_synth:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_map.report_synth:                                  set_distributed_hosts -local
syn_map.report_synth:                                }
syn_map.report_synth:                          }
syn_map.report_synth:                            }}
syn_map.report_synth:set_multi_cpu_usage -local_cpu 1
syn_map.report_synth:#@ End verbose flow_step init_mcpu
syn_map.report_synth:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
