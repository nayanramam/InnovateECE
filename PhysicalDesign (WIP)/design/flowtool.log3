syn_generic:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_generic:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_generic:                              # a typical environment variable exported by distribution platforms and is
syn_generic:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_generic:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_generic:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_generic:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_generic:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_generic:                              } else {
syn_generic:                                set max_cpus 1
syn_generic:                              }
syn_generic:                              switch -glob [get_db program_short_name] {
syn_generic:                                default       {}
syn_generic:                                joules*       -
syn_generic:                                genus*        -
syn_generic:                                innovus*      -
syn_generic:                                tempus*       -
syn_generic:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_generic:                              }
syn_generic:                          if {[get_feature opt_signoff]} {
syn_generic:                                if {[is_flow -inside flow:opt_signoff]} {
syn_generic:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_generic:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_generic:                                  set_distributed_hosts -local
syn_generic:                                }
syn_generic:                          }
syn_generic:                            }}
syn_generic:set_multi_cpu_usage -local_cpu 1
syn_generic:#@ End verbose flow_step init_mcpu
syn_generic:End steps for plugin point Cadence.plugin.flowkit.read_db.post
syn_generic:UM:   flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:*                                                                   init_flow
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:*                                                                   syn_generic
syn_generic:  Setting attribute of root '/': 'flow_report_name' = syn_generic
syn_generic:#@ Begin verbose flow_step synthesis.syn_generic.block_start
syn_generic:@flow_step(block_start)  2:   set_db flow_write_db_common false
syn_generic:  Setting attribute of root '/': 'flow_write_db_common' = false
syn_generic:@flow_step(block_start)  3:   # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
syn_generic:@flow_step(block_start)  4:   # Genus blocks also read rc DBs but are at initialization_complete already,
syn_generic:@flow_step(block_start)  5:   # so we guard with program_short_name to avoid TUI-340 in Genus.
syn_generic:@flow_step(block_start)  6:   if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {
syn_generic:                                set_db init_ground_nets [get_flow_config init_ground_nets]
syn_generic:                                set_db init_power_nets  [get_flow_config init_power_nets]
syn_generic:                                read_physical -lef [get_flow_config init_physical_files lef_files]
syn_generic:                                init_design
syn_generic:                              }
syn_generic:#@ End verbose flow_step synthesis.syn_generic.block_start
syn_generic:      flow.cputime  flow.realtime  timing.setup.tns  timing.setup.wns  snapshot
syn_generic:UM:             30             35                                      block_start
