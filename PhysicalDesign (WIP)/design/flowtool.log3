floorplan:#@ Begin verbose flow_step implementation.floorplan.block_start
floorplan:@@flow 2: set_db flow_write_db_common false
floorplan:@flow 3: # Only apply in Innovus when the input is a Genus synthesis flat DB (rc).
floorplan:@flow 4: # Genus blocks also read rc DBs but are at initialization_complete already,
floorplan:@flow 5: # so we guard with program_short_name to avoid TUI-340 in Genus.
floorplan:@flow 6: if {[string match "innovus*" [get_db program_short_name]] && [dict exists [get_db flow_starting_db] rc]} {
floorplan:@@flow 7: set_db init_ground_nets [get_flow_config init_ground_nets]
floorplan:@@flow 8: set_db init_power_nets  [get_flow_config init_power_nets]
floorplan:@@flow 9: read_physical -lef [get_flow_config init_physical_files lef_files]
