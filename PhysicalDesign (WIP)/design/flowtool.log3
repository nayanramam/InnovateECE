syn_generic:#@ Begin verbose flow_step synthesis.syn_generic.init_design.read_mmmc
syn_generic:@flow_step(read_mmmc)   2:   apply {{} {
syn_generic:                               set FH [open [file join [get_db flow_db_directory] [get_db flow_report_name].mmmc_config.tcl] w]
syn_generic:                             
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               puts $FH "## LIBRARY SETS"
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config library_sets]] {
syn_generic:                             
syn_generic:                                 set library_files [get_flow_config -quiet library_sets $name library_files]
syn_generic:                                 set link_files    [get_flow_config -quiet library_sets $name link_library_files]
syn_generic:                                 set target_files  [get_flow_config -quiet library_sets $name target_library_files]
syn_generic:                                 set aocv_files    [get_flow_config -quiet library_sets $name aocv_files]
syn_generic:                                 set lvf_files     [get_flow_config -quiet library_sets $name lvf_files]
syn_generic:                                 set si_files      [get_flow_config -quiet library_sets $name si_files]
syn_generic:                                 set socv_files    [get_flow_config -quiet library_sets $name socv_files]
syn_generic:                             
syn_generic:                                 puts $FH "create_library_set \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                                 #- define timing_files (.ldb/.lib)
syn_generic:                                 if {[llength $library_files] > 0} {
syn_generic:                                   puts $FH "  -timing \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   if {[llength $library_files] != [llength [join $library_files]]} {
syn_generic:                                     foreach inner_list $library_files {
syn_generic:                                       puts $FH "      \[list \\"
syn_generic:                                       foreach file $inner_list {
syn_generic:                                         puts $FH "        [file normalize $file] \\"
syn_generic:                                       }
syn_generic:                                       puts $FH "      \] \\"
syn_generic:                                     }
syn_generic:                                   } else {
syn_generic:                                     foreach file $library_files {
syn_generic:                                       puts $FH "      [file normalize $file] \\"
syn_generic:                                     }
syn_generic:                                   }
syn_generic:                                   if {[llength [concat $aocv_files $lvf_files $si_files $socv_files]] > 0 } {
syn_generic:                                     puts $FH "    \] \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "    \]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define link/target timing_files (.ldb/.lib)
syn_generic:                                 if {[llength $link_files] > 0 && [llength $target_files] > 0} {
syn_generic:                                   puts $FH "  -link_timing \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $link_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   puts $FH "    \] \\"
syn_generic:                                   puts $FH "  -target_timing \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $target_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   if {[llength [concat $aocv_files $lvf_files $si_files $socv_files]] > 0 } {
syn_generic:                                     puts $FH "    \] \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "    \]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define aocv files
syn_generic:                                 if {[llength $aocv_files] > 0 } {
syn_generic:                                   puts $FH "  -aocv \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $aocv_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   if {[llength [concat $lvf_files $si_files $socv_files]] > 0 } {
syn_generic:                                     puts $FH "    \] \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "    \]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define lvf files
syn_generic:                                 if {[llength $lvf_files] > 0 } {
syn_generic:                                   puts $FH "  -lvf \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $lvf_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   if {[llength [concat $si_files $socv_files]] > 0 } {
syn_generic:                                     puts $FH "    \] \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "    \]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define si files (.cdb)
syn_generic:                                 if {[llength $si_files] > 0 } {
syn_generic:                                   puts $FH "  -si     \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $si_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   if {[llength [concat $socv_files]] > 0 } {
syn_generic:                                     puts $FH "    \] \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "    \]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define socv files
syn_generic:                                 if {[llength $socv_files] > 0 } {
syn_generic:                                   puts $FH "  -socv   \\"
syn_generic:                                   puts $FH "    \[list \\"
syn_generic:                                   foreach file $socv_files {
syn_generic:                                     puts $FH "      [file normalize $file] \\"
syn_generic:                                   }
syn_generic:                                   puts $FH "    \]"
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               puts $FH "## OPERATING CONDITIONS"
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config -quiet opconds]] {
syn_generic:                                 set op_cond_process      [get_flow_config -quiet opconds $name process]
syn_generic:                                 set op_cond_voltage      [get_flow_config -quiet opconds $name voltage]
syn_generic:                                 set op_cond_temperature  [get_flow_config -quiet opconds $name temperature]
syn_generic:                             
syn_generic:                                 puts $FH "create_opcond \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                                 if ![string is space $op_cond_process] {
syn_generic:                                   puts $FH "  -process $op_cond_process \\"
syn_generic:                                 }
syn_generic:                                 if ![string is space $op_cond_voltage] {
syn_generic:                                   puts $FH "  -voltage $op_cond_voltage \\"
syn_generic:                                 }
syn_generic:                                 if ![string is space $op_cond_temperature] {
syn_generic:                                   puts $FH "  -temperature $op_cond_temperature \\"
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               puts $FH "### RC CORNERS"
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config rc_corners]] {
syn_generic:                                 set rc_corner_qrc_tech    [get_flow_config -quiet rc_corners $name qrc_tech_file]
syn_generic:                                 set rc_corner_temperature [get_flow_config -quiet rc_corners $name temperature]
syn_generic:                             
syn_generic:                                 puts $FH "create_rc_corner \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                                 if ![string is space $rc_corner_temperature] {
syn_generic:                                   puts $FH "  -temperature $rc_corner_temperature \\"
syn_generic:                                 }
syn_generic:                                 if ![string is space $rc_corner_qrc_tech] {
syn_generic:                                   puts $FH "  -qrc_tech $rc_corner_qrc_tech"
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               puts $FH "## TIMING CONDITIONS"
syn_generic:                               puts $FH "##############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config timing_conditions]] {
syn_generic:                                 set timing_condition_lib_set [get_flow_config -quiet timing_conditions $name library_sets]
syn_generic:                                 set timing_condition_opcond  [get_flow_config -quiet timing_conditions $name opcond]
syn_generic:                                 set timing_condition_opcond_lib  [get_flow_config -quiet timing_conditions $name opcond_library]
syn_generic:                             
syn_generic:                                 puts $FH "create_timing_condition \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                             
syn_generic:                                 #- Timing Condition library sets validation
syn_generic:                                 puts $FH "  -library_sets \\"
syn_generic:                                 puts $FH "    \[list \\"
syn_generic:                                 foreach tc_lib_set $timing_condition_lib_set {
syn_generic:                                   puts $FH "        $tc_lib_set \\"
syn_generic:                                 }
syn_generic:                                 if {[llength [concat $timing_condition_opcond $timing_condition_opcond_lib]] > 0 } {
syn_generic:                                   puts $FH "    \] \\"
syn_generic:                                 } else {
syn_generic:                                   puts $FH "    \]"
syn_generic:                                 }
syn_generic:                                 if {![string is space $timing_condition_opcond]} {
syn_generic:                                   if {![string is space $timing_condition_opcond_lib]} {
syn_generic:                                     puts $FH "  -opcond $timing_condition_opcond \\"
syn_generic:                                     puts $FH "  -opcond_library $timing_condition_opcond_lib"
syn_generic:                                   } else {
syn_generic:                                    puts $FH "  -opcond $timing_condition_opcond"
syn_generic:                                  }
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               puts $FH "### DELAY CORNERS"
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config delay_corners]] {
syn_generic:                                 set delay_corner_early_rc_corner  [get_flow_config -quiet delay_corners $name rc_corner early]
syn_generic:                                 set delay_corner_late_rc_corner   [get_flow_config -quiet delay_corners $name rc_corner late]
syn_generic:                                 set delay_corner_early_timing_condition [get_flow_config -quiet delay_corners $name timing_condition early]
syn_generic:                                 set delay_corner_late_timing_condition  [get_flow_config -quiet delay_corners $name timing_condition late]
syn_generic:                             
syn_generic:                                 puts $FH "create_delay_corner \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                             
syn_generic:                                 #- define delay_corner -rc_corner
syn_generic:                                 if {![string is space $delay_corner_early_rc_corner] && ![string is space $delay_corner_late_rc_corner]} {
syn_generic:                                   if {$delay_corner_early_rc_corner eq $delay_corner_late_rc_corner} {
syn_generic:                                     puts $FH "  -rc_corner $delay_corner_early_rc_corner \\"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "  -early_rc_corner $delay_corner_early_rc_corner \\"
syn_generic:                                     puts $FH "  -late_rc_corner $delay_corner_late_rc_corner \\"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 #- define delay_corner -timing_condition
syn_generic:                                 if {![string is space $delay_corner_early_timing_condition] && ![string is space $delay_corner_late_timing_condition]} {
syn_generic:                                   if {$delay_corner_early_timing_condition eq $delay_corner_late_timing_condition} {
syn_generic:                                     puts $FH "  -timing_condition [list $delay_corner_early_timing_condition]"
syn_generic:                                   } else {
syn_generic:                                     puts $FH "  -early_timing_condition [list $delay_corner_early_timing_condition] \\"
syn_generic:                                     puts $FH "  -late_timing_condition [list $delay_corner_late_timing_condition]"
syn_generic:                                   }
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               puts $FH "### CONSTRAINT MODES"
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               foreach name [dict keys [get_flow_config constraint_modes]] {
syn_generic:                                 set constraint_mode_sdc       [get_flow_config -quiet constraint_modes $name sdc_files]
syn_generic:                                 set constraint_mode_tcl_vars  [get_flow_config -quiet constraint_modes $name tcl_variables]
syn_generic:                             
syn_generic:                                 puts $FH "create_constraint_mode \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                                 #- Constraint_mode -sdc_files
syn_generic:                                 puts $FH "  -sdc_files \\"
syn_generic:                                 puts $FH "    \[list \\"
syn_generic:                                 foreach file $constraint_mode_sdc {
syn_generic:                                   puts $FH "      [file normalize $file] \\"
syn_generic:                                 }
syn_generic:                                 #- Constraint_mode -tcl_vars
syn_generic:                                 if ![string is space $constraint_mode_tcl_vars] {
syn_generic:                                   puts $FH "    \] \\"
syn_generic:                                   puts $FH "  -tcl_variables \{$constraint_mode_tcl_vars\}"
syn_generic:                                 } else {
syn_generic:                                   puts $FH "    \]"
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               puts $FH "### ANALYSIS VIEWS"
syn_generic:                               puts $FH "###############################################################################"
syn_generic:                               set analysis_view_is_setup_list   ""
syn_generic:                               set analysis_view_is_hold_list    ""
syn_generic:                               set analysis_view_is_dynamic_list ""
syn_generic:                               set analysis_view_is_leakage_list ""
syn_generic:                               foreach name [dict keys [get_flow_config analysis_views]] {
syn_generic:                                 puts $FH "create_analysis_view \\"
syn_generic:                                 puts $FH "  -name $name \\"
syn_generic:                                 puts $FH "  -constraint_mode [get_flow_config -quiet analysis_views $name constraint_mode] \\"
syn_generic:                                 if {![string is space [get_flow_config -quiet analysis_views $name power_modes]]} {
syn_generic:                                   puts $FH "  -power_modes [get_flow_config -quiet analysis_views $name power_modes] \\"
syn_generic:                                 }
syn_generic:                                 puts $FH "  -delay_corner [get_flow_config -quiet analysis_views $name delay_corner]"
syn_generic:                                 #- Sort views by purpose
syn_generic:                                 if {[string is true -strict [get_flow_config -quiet analysis_views $name is_setup]]} {
syn_generic:                                   lappend analysis_view_is_setup_list $name
syn_generic:                                 }
syn_generic:                                 if {[string is true -strict [get_flow_config -quiet analysis_views $name is_hold]]} {
syn_generic:                                   lappend analysis_view_is_hold_list $name
syn_generic:                                 }
syn_generic:                                 if {[string is true -strict [get_flow_config -quiet analysis_views $name is_leakage]]} {
syn_generic:                                   lappend analysis_view_is_leakage_list $name
syn_generic:                                 }
syn_generic:                                 if {[string is true -strict [get_flow_config -quiet analysis_views $name is_dynamic]]} {
syn_generic:                                   lappend analysis_view_is_dynamic_list $name
syn_generic:                                 }
syn_generic:                                 puts $FH ""
syn_generic:                               }
syn_generic:                             
syn_generic:                               #- Override view list with feature values when available
syn_generic:                               if {[get_feature setup_views] ne ""} {
syn_generic:                                 set analysis_view_is_setup_list [get_feature setup_views]
syn_generic:                               }
syn_generic:                               if {[get_feature hold_views] ne ""} {
syn_generic:                                 set analysis_view_is_hold_list [get_feature hold_views]
syn_generic:                               }
syn_generic:                               if {[get_feature leakage_view] ne ""} {
syn_generic:                                 set analysis_view_is_leakage_list [get_feature leakage_view]
syn_generic:                               }
syn_generic:                               if {[get_feature dynamic_view] ne ""} {
syn_generic:                                 set analysis_view_is_dynamic_list [get_feature dynamic_view]
syn_generic:                               }
syn_generic:                             
syn_generic:                               #- Configure the Analysis View
syn_generic:                               puts $FH "set_analysis_view \\"
syn_generic:                               puts $FH "  -setup   \[list $analysis_view_is_setup_list\] \\"
syn_generic:                               if {[llength $analysis_view_is_leakage_list] > 0 && [llength $analysis_view_is_dynamic_list] > 0} {
syn_generic:                                 puts $FH "  -hold    \[list $analysis_view_is_hold_list\] \\"
syn_generic:                                 puts $FH "  -leakage \[list $analysis_view_is_leakage_list\] \\"
syn_generic:                                 puts $FH "  -dynamic \[list $analysis_view_is_dynamic_list\]"
syn_generic:                               } elseif {[llength $analysis_view_is_leakage_list] > 0 && [llength $analysis_view_is_dynamic_list] == 0} {
syn_generic:                                 puts $FH "  -hold    \[list $analysis_view_is_hold_list\] \\"
syn_generic:                                 puts $FH "  -leakage \[list $analysis_view_is_leakage_list\]"
syn_generic:                               } elseif {[llength $analysis_view_is_leakage_list] == 0 && [llength $analysis_view_is_dynamic_list] > 0} {
syn_generic:                                 puts $FH "  -hold    \[list $analysis_view_is_hold_list\] \\"
syn_generic:                                 puts $FH "  -dynamic \[list $analysis_view_is_dynamic_list\]"
syn_generic:                               } else {
syn_generic:                                 puts $FH "  -hold    \[list $analysis_view_is_hold_list\]"
syn_generic:                               }
syn_generic:                               puts $FH ""
syn_generic:                               close $FH
syn_generic:                             
syn_generic:                               #- Read MMMC file
syn_generic:                               if {[is_flow -inside flow:init_design]} {
syn_generic:                                 read_mmmc [file join [get_db flow_db_directory] [get_db flow_report_name].mmmc_config.tcl]
syn_generic:                               }
syn_generic:                             }}
