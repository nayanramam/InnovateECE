syn_map:#@ Begin verbose flow_step synthesis.syn_map.block_finish
syn_map:@flow_step(block_finish)  2:   apply {{} {
syn_map:                                 set_db flow_report_name [get_db [lindex [get_db flow_hier_path] end] .name]
syn_map:                                 if {[is_flow -inside flow:syn_opt] && [get_feature use_common_db]} {
syn_map:                                   set_db flow_write_db_common true
syn_map:                                 }
syn_map:                                 if {[get_db flow_branch] ne ""} {
syn_map:                                   set out_dir [file join [get_db flow_db_directory] [get_db flow_branch]_[get_db flow_report_name]]
syn_map:                                 } else {
syn_map:                                   set out_dir [file join [get_db flow_db_directory] [get_db flow_report_name]]
syn_map:                                 }
syn_map:                                 set_db flow_spef_directory $out_dir
syn_map:                                 catch {report_obj -tcl} flow_root_config
syn_map:                                 if {[dict exists $flow_root_config root:/]} {
syn_map:                                   set flow_root_config [dict get $flow_root_config root:/]
syn_map:                                 } elseif {[dict exists $flow_root_config root:]} {
syn_map:                                   set flow_root_config [dict get $flow_root_config root:]
syn_map:                                 } else {
syn_map:                                 }
syn_map:                                 foreach key [dict keys $flow_root_config] {
syn_map:                                   if {[string length [dict get $flow_root_config $key]] > 200} {
syn_map:                                     dict set flow_root_config $key "\[long value truncated\]"
syn_map:                                   }
syn_map:                                 }
syn_map:                                 set_metric -name flow.root_config -value $flow_root_config
syn_map:                               }}
syn_map:  Setting attribute of root '/': 'flow_report_name' = syn_map
syn_map:  Setting attribute of root '/': 'flow_spef_directory' = dbs/syn_map
syn_map:#@ End verbose flow_step synthesis.syn_map.block_finish
