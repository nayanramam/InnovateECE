syn_opt:#@ Begin verbose flow_step activate_views
syn_opt:@flow_step(activate_views)  2:   apply {{} {
syn_opt:                                   set db [get_db flow_starting_db]
syn_opt:                                   set flow [lindex [get_db flow_hier_path] end]
syn_opt:                                   set setup_views [get_feature -obj $flow setup_views]
syn_opt:                                   set hold_views [get_feature -obj $flow hold_views]
syn_opt:                                   set leakage_view [get_feature -obj $flow leakage_view]
syn_opt:                                   set dynamic_view [get_feature -obj $flow dynamic_view]
syn_opt:                                 
syn_opt:                                   if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_opt:                                     #- use read_db args for DB types and set_analysis_views for TCL
syn_opt:                                     if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
syn_opt:                                       set cmd "set_analysis_view"
syn_opt:                                       if {$setup_views ne ""} {
syn_opt:                                         append cmd " -setup [list $setup_views]"
syn_opt:                                       } else {
syn_opt:                                         append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_opt:                                       }
syn_opt:                                       if {$hold_views ne ""} {
syn_opt:                                         append cmd " -hold [list $hold_views]"
syn_opt:                                       } else {
syn_opt:                                         append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_opt:                                       }
syn_opt:                                       if {$leakage_view ne ""} {
syn_opt:                                         append cmd " -leakage [list $leakage_view]"
syn_opt:                                       } else {
syn_opt:                                         if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_opt:                                           append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_opt:                                         }
syn_opt:                                       }
syn_opt:                                       if {$dynamic_view ne ""} {
syn_opt:                                         append cmd " -dynamic [list $dynamic_view]"
syn_opt:                                       } else {
syn_opt:                                         if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_opt:                                           append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_opt:                                         }
syn_opt:                                       }
syn_opt:                                       eval $cmd
syn_opt:                                     } elseif {[llength [get_db analysis_views]] == 0} {
syn_opt:                                       set cmd "set_flowkit_read_db_args"
syn_opt:                                       if {$setup_views ne ""} {
syn_opt:                                         append cmd " -setup_views [list $setup_views]"
syn_opt:                                       }
syn_opt:                                       if {$hold_views ne ""} {
syn_opt:                                         append cmd " -hold_views [list $hold_views]"
syn_opt:                                       }
syn_opt:                                       if {$leakage_view ne ""} {
syn_opt:                                         append cmd " -leakage_view [list $leakage_view]"
syn_opt:                                       }
syn_opt:                                       if {$dynamic_view ne ""} {
syn_opt:                                         append cmd " -dynamic_view [list $dynamic_view]"
syn_opt:                                       }
syn_opt:                                       eval $cmd
syn_opt:                                     } else {
syn_opt:                                     }
syn_opt:                                   }
syn_opt:                                 }}
syn_opt:#@ End verbose flow_step activate_views
syn_opt:#@ Begin verbose flow_step init_mcpu
syn_opt:@flow_step(init_mcpu)  2:   apply {{} {
syn_opt:                              # Multi host/cpu attributes
syn_opt:                              #-----------------------------------------------------------------------------
syn_opt:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_opt:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_opt:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_opt:                              # a typical environment variable exported by distribution platforms and is
syn_opt:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_opt:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_opt:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_opt:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_opt:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_opt:                              } else {
syn_opt:                                set max_cpus 1
syn_opt:                              }
syn_opt:                              switch -glob [get_db program_short_name] {
syn_opt:                                default       {}
syn_opt:                                joules*       -
syn_opt:                                genus*        -
syn_opt:                                innovus*      -
syn_opt:                                tempus*       -
syn_opt:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_opt:                              }
syn_opt:                          if {[get_feature opt_signoff]} {
syn_opt:                                if {[is_flow -inside flow:opt_signoff]} {
syn_opt:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_opt:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_opt:                                  set_distributed_hosts -local
syn_opt:                                }
syn_opt:                          }
syn_opt:                            }}
syn_opt:set_multi_cpu_usage -local_cpu 1
syn_opt:#@ End verbose flow_step init_mcpu
syn_opt:End steps for plugin point Cadence.plugin.flowkit.read_db.pre
