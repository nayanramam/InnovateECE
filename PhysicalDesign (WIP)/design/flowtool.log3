syn_map.report_synth:Begin steps for plugin point Cadence.plugin.flowkit.read_db.post
syn_map.report_synth:#@ Begin verbose flow_step activate_views
syn_map.report_synth:@flow_step(activate_views)  2:   apply {{} {
syn_map.report_synth:                                   set db [get_db flow_starting_db]
syn_map.report_synth:                                   set flow [lindex [get_db flow_hier_path] end]
syn_map.report_synth:                                   set setup_views [get_feature -obj $flow setup_views]
syn_map.report_synth:                                   set hold_views [get_feature -obj $flow hold_views]
syn_map.report_synth:                                   set leakage_view [get_feature -obj $flow leakage_view]
syn_map.report_synth:                                   set dynamic_view [get_feature -obj $flow dynamic_view]
syn_map.report_synth:                                 
syn_map.report_synth:                                   if {($setup_views ne "") || ($hold_views ne "") || ($leakage_view ne "") || ($dynamic_view ne "")} {
syn_map.report_synth:                                     #- use read_db args for DB types and set_analysis_views for TCL
syn_map.report_synth:                                     if {([llength [get_db analysis_views]]) > 0 &&  ([lindex $db 0] eq {tcl} || [lindex $db 0] in {enc cdb} && [file isfile [lindex $db 1]])} {
syn_map.report_synth:                                       set cmd "set_analysis_view"
syn_map.report_synth:                                       if {$setup_views ne ""} {
syn_map.report_synth:                                         append cmd " -setup [list $setup_views]"
syn_map.report_synth:                                       } else {
syn_map.report_synth:                                         append cmd " -setup [list [get_db [get_db analysis_views -if .is_setup] .name]]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$hold_views ne ""} {
syn_map.report_synth:                                         append cmd " -hold [list $hold_views]"
syn_map.report_synth:                                       } else {
syn_map.report_synth:                                         append cmd " -hold [list [get_db [get_db analysis_views -if .is_hold] .name]]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$leakage_view ne ""} {
syn_map.report_synth:                                         append cmd " -leakage [list $leakage_view]"
syn_map.report_synth:                                       } else {
syn_map.report_synth:                                         if {[llength [get_db analysis_views -if .is_leakage]] > 0} {
syn_map.report_synth:                                           append cmd " -leakage [list [get_db [get_db analysis_views -if .is_leakage] .name]]"
syn_map.report_synth:                                         }
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$dynamic_view ne ""} {
syn_map.report_synth:                                         append cmd " -dynamic [list $dynamic_view]"
syn_map.report_synth:                                       } else {
syn_map.report_synth:                                         if {[llength [get_db analysis_views -if .is_dynamic]] > 0} {
syn_map.report_synth:                                           append cmd " -dynamic [list [get_db [get_db analysis_views -if .is_dynamic] .name]]"
syn_map.report_synth:                                         }
syn_map.report_synth:                                       }
syn_map.report_synth:                                       eval $cmd
syn_map.report_synth:                                     } elseif {[llength [get_db analysis_views]] == 0} {
syn_map.report_synth:                                       set cmd "set_flowkit_read_db_args"
syn_map.report_synth:                                       if {$setup_views ne ""} {
syn_map.report_synth:                                         append cmd " -setup_views [list $setup_views]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$hold_views ne ""} {
syn_map.report_synth:                                         append cmd " -hold_views [list $hold_views]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$leakage_view ne ""} {
syn_map.report_synth:                                         append cmd " -leakage_view [list $leakage_view]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       if {$dynamic_view ne ""} {
syn_map.report_synth:                                         append cmd " -dynamic_view [list $dynamic_view]"
syn_map.report_synth:                                       }
syn_map.report_synth:                                       eval $cmd
syn_map.report_synth:                                     } else {
syn_map.report_synth:                                     }
syn_map.report_synth:                                   }
syn_map.report_synth:                                 }}
syn_map.report_synth:#@ End verbose flow_step activate_views
syn_map.report_synth:#@ Begin verbose flow_step init_mcpu
syn_map.report_synth:@flow_step(init_mcpu)  2:   apply {{} {
syn_map.report_synth:                              # Multi host/cpu attributes
syn_map.report_synth:                              #-----------------------------------------------------------------------------
syn_map.report_synth:                              # The FLOWTOOL_NUM_CPUS is an environment variable which should be exported by
syn_map.report_synth:                              # the specified dist script.  This connects the number of CPUs being reserved
syn_map.report_synth:                              # for batch jobs with the current flow scripts.  The LSB_MAX_NUM_PROCESSORS is
syn_map.report_synth:                              # a typical environment variable exported by distribution platforms and is
syn_map.report_synth:                              # useful for ensuring all interactive jobs are using the reserved amount of CPUs.
syn_map.report_synth:                              if {[info exists ::env(FLOWTOOL_NUM_CPUS)]} {
syn_map.report_synth:                                set max_cpus $::env(FLOWTOOL_NUM_CPUS)
syn_map.report_synth:                              } elseif {[info exists ::env(LSB_MAX_NUM_PROCESSORS)]} {
syn_map.report_synth:                                set max_cpus $::env(LSB_MAX_NUM_PROCESSORS)
syn_map.report_synth:                              } else {
syn_map.report_synth:                                set max_cpus 1
syn_map.report_synth:                              }
syn_map.report_synth:                              switch -glob [get_db program_short_name] {
syn_map.report_synth:                                default       {}
syn_map.report_synth:                                joules*       -
syn_map.report_synth:                                genus*        -
syn_map.report_synth:                                innovus*      -
syn_map.report_synth:                                tempus*       -
syn_map.report_synth:                                voltus*       { set_multi_cpu_usage -verbose -local_cpu $max_cpus }
syn_map.report_synth:                              }
syn_map.report_synth:                          if {[get_feature opt_signoff]} {
syn_map.report_synth:                                if {[is_flow -inside flow:opt_signoff]} {
syn_map.report_synth:                                  set_multi_cpu_usage -verbose -remote_host 1
syn_map.report_synth:                                  set_multi_cpu_usage -verbose -cpu_per_remote_host 16
syn_map.report_synth:                                  set_distributed_hosts -local
syn_map.report_synth:                                }
syn_map.report_synth:                          }
syn_map.report_synth:                            }}
syn_map.report_synth:set_multi_cpu_usage -local_cpu 1
syn_map.report_synth:#@ End verbose flow_step init_mcpu
syn_map.report_synth:End steps for plugin point Cadence.plugin.flowkit.read_db.post
